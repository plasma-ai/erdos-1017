private theorem interval_parameter {a b v : ℝ} (hv : v ∈ Icc a b) :
    ∃ x : I, a + (b - a) * x = v := by
  by_cases heq : a = b
  · have he : v = a := by rw [← heq] at hv; linarith only [hv.1, hv.2]
    exact ⟨0, by rw [he]; norm_num⟩
  · have hw : 0 < b - a := sub_pos.mpr (lt_of_le_of_ne (hv.1.trans hv.2) heq)
    let x : I := ⟨(v - a) / (b - a),
      div_nonneg (sub_nonneg.mpr hv.1) hw.le,
      (div_le_one hw).mpr (by linarith only [hv.2])⟩
    refine ⟨x, ?_⟩
    change a + (b - a) * ((v - a) / (b - a)) = v
    rw [mul_div_cancel₀ _ hw.ne']
    ring

private theorem positive_en {δ A E : ℝ}
    (hδ : δ ∈ Icc (1 / 4 : ℝ) (2 / 5))
    (hA : A ∈ Icc (7 / 20 : ℝ) (3 / 8))
    (hE : E ∈ Icc (1 / 20 : ℝ) (29 / 250)) : 0 < en δ A E := by
  rw [en_eq]
  apply mul_pos (by linarith only [hδ.1])
  dsimp [enFactor]
  linarith only [hA.2, hE.2]

/-- All denominator and variable affine-width signs follow from the hard
sector's actual closed enclosure. -/
theorem enclosure_positive_factors {δ A E L : ℝ}
    (hδ : δ ∈ Icc (1 / 4 : ℝ) (2 / 5))
    (hA : A ∈ Icc (7 / 20 : ℝ) (3 / 8))
    (hE : E ∈ Icc (1 / 20 : ℝ) (29 / 250))
    (hL : L ∈ Icc E (E + (3 * A - 1) / 2)) :
    0 < δ ∧ 0 < E ∧ 0 < en δ A E ∧ 0 < L + E ∧
      0 < 3 * A - 1 ∧ 0 < baseDifference A (A + E) - L := by
  refine ⟨by linarith only [hδ.1], by linarith only [hE.1],
    positive_en hδ hA hE, by linarith only [hE.1, hL.1],
    by linarith only [hA.1], ?_⟩
  unfold baseDifference
  linarith only [hA.1, hL.2]

/-- The source selector comparison holds on the entire hard-sector enclosure. -/
theorem selector_guard_pos {δ A E : ℝ}
    (hδ : δ ∈ Icc (1 / 4 : ℝ) (2 / 5))
    (hA : A ∈ Icc (7 / 20 : ℝ) (3 / 8))
    (hE : E ∈ Icc (1 / 20 : ℝ) (29 / 250)) :
    0 < 2 * en δ A E * (2 * A * E - A ^ 2 + 123 / 1000) -
      A * (2 - 5 * A - 2 * E) * Nmax δ A E := by
  obtain ⟨x, hx⟩ := interval_parameter hδ
  obtain ⟨y, hy⟩ := interval_parameter hA
  obtain ⟨z, hz⟩ := interval_parameter hE
  have hx' : hardDelta x = δ := by dsimp [hardDelta]; nlinarith only [hx]
  have hy' : hardA y = A := by dsimp [hardA]; nlinarith only [hy]
  have hz' : hardE z = E := by dsimp [hardE]; nlinarith only [hz]
  have hp := guard_chart x y z
  rw [hx', hy', hz'] at hp
  exact hp

/-- The literal zero-moment score has strictly positive source-mass derivative
on the full correlated prism. -/
theorem zero_derivative_pos {δ A E L j : ℝ}
    (hδ : δ ∈ Icc (1 / 4 : ℝ) (2 / 5))
    (hA : A ∈ Icc (7 / 20 : ℝ) (3 / 8))
    (hE : E ∈ Icc (1 / 20 : ℝ) (29 / 250))
    (hL : L ∈ Icc E (E + (3 * A - 1) / 2))
    (hj : j ∈ Icc (2 * L) (baseDifference A (A + E) + L)) :
    0 < PhiZeroDerivative δ A E L j := by
  have hδ0 : 0 < δ := by linarith only [hδ.1]
  have hen := positive_en hδ hA hE
  obtain ⟨x, hx⟩ := interval_parameter hδ
  obtain ⟨y, hy⟩ := interval_parameter hA
  obtain ⟨z, hz⟩ := interval_parameter hE
  obtain ⟨u, hu⟩ := interval_parameter hL
  obtain ⟨w, hw⟩ := interval_parameter hj
  have hx' : hardDelta x = δ := by dsimp [hardDelta]; nlinarith only [hx]
  have hy' : hardA y = A := by dsimp [hardA]; nlinarith only [hy]
  have hz' : hardE z = E := by dsimp [hardE]; nlinarith only [hz]
  have hu' : hardL A E u = L := by dsimp [hardL]; nlinarith only [hu]
  have hw' : hardJ A E L w = j := by dsimp [hardJ]; nlinarith only [hw]
  have hp := derivative_chart x y z u w
  rw [hx', hy', hz', hu', hw', clearedDerivative_eq hδ0.ne' hen.ne'] at hp
  exact (mul_pos_iff_of_pos_left (mul_pos (by norm_num) hen)).mp hp

/-- The zero-moment score is positive at the genuine lower source-mass
endpoint, with the E denominator licensed by the enclosure itself. -/
theorem zero_lower_endpoint_pos {δ A E L : ℝ}
    (hδ : δ ∈ Icc (1 / 4 : ℝ) (2 / 5))
    (hA : A ∈ Icc (7 / 20 : ℝ) (3 / 8))
    (hE : E ∈ Icc (1 / 20 : ℝ) (29 / 250))
    (hL : L ∈ Icc E (E + (3 * A - 1) / 2)) :
    0 < Phi δ A E L 0 ((L + E) * L / E) := by
  have hδ0 : 0 < δ := by linarith only [hδ.1]
  have hE0 : 0 < E := by linarith only [hE.1]
  have hen := positive_en hδ hA hE
  obtain ⟨x, hx⟩ := interval_parameter hδ
  obtain ⟨y, hy⟩ := interval_parameter hA
  obtain ⟨z, hz⟩ := interval_parameter hE
  obtain ⟨u, hu⟩ := interval_parameter hL
  have hx' : hardDelta x = δ := by dsimp [hardDelta]; nlinarith only [hx]
  have hy' : hardA y = A := by dsimp [hardA]; nlinarith only [hy]
  have hz' : hardE z = E := by dsimp [hardE]; nlinarith only [hz]
  have hu' : hardL A E u = L := by dsimp [hardL]; nlinarith only [hu]
  have hp := lower_chart x y z u
  rw [hx', hy', hz', hu', homogeneousZero_eq hδ0.ne' hen.ne' hE0.ne'] at hp
  exact (mul_pos_iff_of_pos_left (mul_pos (mul_pos (by norm_num) hen) (pow_pos hE0 4))).mp hp

/-- The actual q=E moment score is positive throughout the full hard-sector
prism, retaining the coupled source endpoint rather than an E2 parameter. -/
theorem moment_endpoint_pos {δ A E L j : ℝ}
    (hδ : δ ∈ Icc (1 / 4 : ℝ) (2 / 5))
    (hA : A ∈ Icc (7 / 20 : ℝ) (3 / 8))
    (hE : E ∈ Icc (1 / 20 : ℝ) (29 / 250))
    (hL : L ∈ Icc E (E + (3 * A - 1) / 2))
    (hj : j ∈ Icc (2 * L) (baseDifference A (A + E) + L)) :
    0 < Phi δ A E L E j := by
  have hδ0 : 0 < δ := by linarith only [hδ.1]
  have hE0 : 0 < E := by linarith only [hE.1]
  have hC : 0 < L + E := by linarith only [hL.1, hE0]
  have hen := positive_en hδ hA hE
  obtain ⟨x, hx⟩ := interval_parameter hδ
  obtain ⟨y, hy⟩ := interval_parameter hA
  obtain ⟨z, hz⟩ := interval_parameter hE
  obtain ⟨u, hu⟩ := interval_parameter hL
  obtain ⟨w, hw⟩ := interval_parameter hj
  have hx' : hardDelta x = δ := by dsimp [hardDelta]; nlinarith only [hx]
  have hy' : hardA y = A := by dsimp [hardA]; nlinarith only [hy]
  have hz' : hardE z = E := by dsimp [hardE]; nlinarith only [hz]
  have hu' : hardL A E u = L := by dsimp [hardL]; nlinarith only [hu]
  have hw' : hardJ A E L w = j := by dsimp [hardJ]; nlinarith only [hw]
  have hp := moment_chart x y z u w
  rw [hx', hy', hz', hu', hw', clearedMomentEndpoint_eq hδ0.ne' hen.ne' hC.ne'] at hp
  exact (mul_pos_iff_of_pos_left (mul_pos (mul_pos (by norm_num) hen) hC)).mp hp

