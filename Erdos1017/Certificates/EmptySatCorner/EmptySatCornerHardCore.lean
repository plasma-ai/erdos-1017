/-- The original correlated intercept on the hard-sector scalar enclosure. -/
def gamma (δ A E : ℝ) : ℝ := δ * (1 - (A + E)) / 2

/-- The positive numerator A*eta from the original negative-load quota. -/
def en (δ A E : ℝ) : ℝ := 3 * gamma δ A E - δ * A

/-- The original upper negative-load resource. -/
def Nmax (δ A E : ℝ) : ℝ :=
  (1 - δ + gamma δ A E - (2 - δ) * A) / 2

/-- The literal second-head mass after the actual source partition. -/
def b (A E L : ℝ) : ℝ := 1 - 2 * A - E - L

/-- The original whole negative-load coefficient. -/
def Bc (A E L : ℝ) : ℝ := 1 - 3 * A + b A E L

/-- The active support price with its original correlated intercept. -/
def P0 (δ A E L : ℝ) : ℝ :=
  let D := A + E
  let v := baseDifference A D
  let K := baseCredit δ A D
  let p := (4 * (2 - δ) * v + 8 * D) / 25
  37 / 1250 - 2 * (1 - δ) * v ^ 2 - D ^ 2 / 12 + (12 / 25) * K ^ 2 -
    p * L - (8 / 25) * L ^ 2 - 4 * δ * b A E L * L

/-- The lower cost after spending the one original negative-load quota. -/
def Wlo (δ A E L : ℝ) : ℝ :=
  123 / 1000 - A * Bc A E L * Nmax δ A E / (2 * en δ A E)

/-- The genuine coupled source edge moment at scalar endpoint q. -/
def edgeMoment (q j : ℝ) : ℝ := j * (j - q) / 2

/-- The corresponding source selector mass. -/
def Kq (A q j : ℝ) : ℝ := A * j - edgeMoment q j

/-- The lower shifted source moment; q remains the actual moment endpoint. -/
def Fq (δ E L q j : ℝ) : ℝ :=
  δ * j * (j - 2 * L) - δ * j * (L - E) * q / (L + E)

/-- The original correlated source price. -/
def Cq (δ A E L q j : ℝ) : ℝ :=
  Fq δ E L q j / 2 - (1 - δ) * edgeMoment q j + A * j - A * δ * (j - L)

/-- The original signed source-to-rest charge. -/
def Rq (δ A E L q j : ℝ) : ℝ :=
  j * (gamma δ A E + (1 - δ) * (b A E L + j) - A) + A * δ * (j - L) - Fq δ E L q j

/-- The literal hard-sector lower score. Its q is a coupled moment,
never a stationary-family parameter. -/
def Phi (δ A E L q j : ℝ) : ℝ :=
  let K := Kq A q j
  let Z0 := gamma δ A E + (1 - δ) * b A E L
  Cq δ A E L q j * (Wlo δ A E L - K) - K * b A E L * Z0 +
    (A ^ 2 - K) * Rq δ A E L q j + K * (1 - δ) * P0 δ A E L / (4 * δ)

/-- The exact derivative of the zero-moment score in the source mass. -/
def PhiZeroDerivative (δ A E L j : ℝ) : ℝ :=
  let Cp := (1 - δ) * A - δ * L - (1 - 2 * δ) * j
  let Kp := A - j
  let Rp := gamma δ A E + (1 - δ) * (b A E L - A) + 2 * δ * L + 2 * (1 - 2 * δ) * j
  Cp * (Wlo δ A E L - Kq A 0 j) + (A ^ 2 - Kq A 0 j) * Rp -
    Kp * (Cq δ A E L 0 j + Rq δ A E L 0 j +
      b A E L * (gamma δ A E + (1 - δ) * b A E L) - (1 - δ) * P0 δ A E L / (4 * δ))

/-- The zero-moment derivative is derived from the literal Phi formula;
no slope or monotonicity certificate is assumed. -/
theorem PhiZero_hasDerivAt (δ A E L j : ℝ) :
    HasDerivAt (fun t => Phi δ A E L 0 t) (PhiZeroDerivative δ A E L j) j := by
  let Cp := (1 - δ) * A - δ * L - (1 - 2 * δ) * j
  let Rp := gamma δ A E + (1 - δ) * (b A E L - A) + 2 * δ * L + 2 * (1 - 2 * δ) * j
  have hK : HasDerivAt (fun t => Kq A 0 t) (A - j) j := by
    convert ((hasDerivAt_id j).const_mul A).sub ((hasDerivAt_pow 2 j).div_const 2) using 1
    all_goals try funext t
    all_goals try simp only [Kq, edgeMoment, sub_zero, Pi.sub_apply, id_eq]
    all_goals ring
  have hC : HasDerivAt (fun t => Cq δ A E L 0 t) Cp j := by
    convert (((hasDerivAt_pow 2 j).const_mul (-(1 - 2 * δ) / 2)).add
      ((hasDerivAt_id j).const_mul ((1 - δ) * A - δ * L))).add_const (A * δ * L) using 1
    all_goals try funext t
    all_goals try simp only [Cq, Fq, edgeMoment, Cp, mul_zero, zero_div, sub_zero,
      Pi.add_apply, id_eq]
    all_goals ring
  have hR : HasDerivAt (fun t => Rq δ A E L 0 t) Rp j := by
    convert (((hasDerivAt_pow 2 j).const_mul (1 - 2 * δ)).add
      ((hasDerivAt_id j).const_mul
        (gamma δ A E + (1 - δ) * (b A E L - A) + 2 * δ * L))).add_const (-A * δ * L) using 1
    all_goals try funext t
    all_goals try simp only [Rq, Fq, Rp, mul_zero, zero_div, sub_zero, Pi.add_apply, id_eq]
    all_goals ring
  have h := (((hC.mul ((hasDerivAt_const j (Wlo δ A E L)).sub hK)).sub
    (hK.mul_const (b A E L * (gamma δ A E + (1 - δ) * b A E L)))).add
      (((hasDerivAt_const j (A ^ 2)).sub hK).mul hR)).add
        (hK.mul_const ((1 - δ) * P0 δ A E L / (4 * δ)))
  convert h using 1
  all_goals try funext t
  all_goals try simp only [Phi, PhiZeroDerivative, Cp, Rp, Pi.add_apply, Pi.sub_apply, Pi.mul_apply]
  all_goals ring

def enFactor (A E : ℝ) : ℝ := 3 * (1 - (A + E)) / 2 - A

theorem en_eq (δ A E : ℝ) : en δ A E = δ * enFactor A E := by
  unfold en gamma enFactor
  ring

def homogeneousZero (δ A E L n d : ℝ) : ℝ :=
  let K := A * n * d - n ^ 2 / 2
  let beta := 1 - 2 * δ
  let aa := (1 - δ) * A - δ * L
  let dc := gamma δ A E + (1 - δ) * (b A E L - A) + 2 * δ * L
  let C := -beta * n ^ 2 / 2 + aa * n * d + A * δ * L * d ^ 2
  let R := beta * n ^ 2 + dc * n * d - A * δ * L * d ^ 2
  let Z0 := gamma δ A E + (1 - δ) * b A E L
  2 * en δ A E * (C * ((123 / 1000) * d ^ 2 - K) - K * b A E L * Z0 * d ^ 2 +
    (A ^ 2 * d ^ 2 - K) * R) - A * C * Bc A E L * Nmax δ A E * d ^ 2 +
    enFactor A E * K * (1 - δ) * P0 δ A E L * d ^ 2 / 2

def clearedDerivative (δ A E L j : ℝ) : ℝ :=
  let Cp := (1 - δ) * A - δ * L - (1 - 2 * δ) * j
  let Kp := A - j
  let Rp := gamma δ A E + (1 - δ) * (b A E L - A) + 2 * δ * L + 2 * (1 - 2 * δ) * j
  let K := Kq A 0 j
  let C := -(1 - 2 * δ) * j ^ 2 / 2 + ((1 - δ) * A - δ * L) * j + A * δ * L
  let R := (1 - 2 * δ) * j ^ 2 +
    (gamma δ A E + (1 - δ) * (b A E L - A) + 2 * δ * L) * j - A * δ * L
  let Z0 := gamma δ A E + (1 - δ) * b A E L
  2 * en δ A E * (Cp * ((123 / 1000) - K) + (A ^ 2 - K) * Rp - Kp * (C + R + b A E L * Z0)) -
    A * Cp * Bc A E L * Nmax δ A E + enFactor A E * Kp * (1 - δ) * P0 δ A E L / 2

def clearedMomentEndpoint (δ A E L j : ℝ) : ℝ :=
  let C := L + E
  let e := edgeMoment E j
  let K := A * j - e
  let F := δ * j * (j - 2 * L) * C - δ * j * (L - E) * E
  let C0 := F / 2 - (1 - δ) * e * C + A * j * C - A * δ * (j - L) * C
  let R := (j * (gamma δ A E + (1 - δ) * (b A E L + j) - A) + A * δ * (j - L)) * C - F
  let Z0 := gamma δ A E + (1 - δ) * b A E L
  2 * en δ A E * (C0 * ((123 / 1000) - K) - K * b A E L * Z0 * C + (A ^ 2 - K) * R) -
    A * C0 * Bc A E L * Nmax δ A E + enFactor A E * K * (1 - δ) * P0 δ A E L * C / 2

theorem homogeneousZero_eq {δ A E L n d : ℝ}
    (hδ : δ ≠ 0) (hen : en δ A E ≠ 0) (hd : d ≠ 0) :
    homogeneousZero δ A E L n d = 2 * en δ A E * d ^ 4 * Phi δ A E L 0 (n / d) := by
  have hg : enFactor A E ≠ 0 := by
    intro hz
    apply hen
    rw [en_eq, hz, mul_zero]
  unfold homogeneousZero Phi Wlo Cq Rq Fq Kq edgeMoment
  simp only [mul_zero, zero_div, sub_zero]
  simp_rw [en_eq]
  field_simp [hδ, hg, hd]
  ring

theorem clearedDerivative_eq {δ A E L j : ℝ}
    (hδ : δ ≠ 0) (hen : en δ A E ≠ 0) :
    clearedDerivative δ A E L j = 2 * en δ A E * PhiZeroDerivative δ A E L j := by
  have hg : enFactor A E ≠ 0 := by
    intro hz
    apply hen
    rw [en_eq, hz, mul_zero]
  unfold clearedDerivative PhiZeroDerivative Wlo Cq Rq Fq Kq edgeMoment
  simp only [mul_zero, zero_div, sub_zero]
  simp_rw [en_eq]
  field_simp [hδ, hg]
  ring

theorem clearedMomentEndpoint_eq {δ A E L j : ℝ}
    (hδ : δ ≠ 0) (hen : en δ A E ≠ 0) (hC : L + E ≠ 0) :
    clearedMomentEndpoint δ A E L j = 2 * en δ A E * (L + E) * Phi δ A E L E j := by
  have hg : enFactor A E ≠ 0 := by
    intro hz
    apply hen
    rw [en_eq, hz, mul_zero]
  unfold clearedMomentEndpoint Phi Wlo Cq Rq Fq Kq edgeMoment
  simp_rw [en_eq]
  field_simp [hδ, hg, hC]
  ring


private theorem tensor3_pos (n m l : ℕ)
    (c : Fin (n + 1) → Fin (m + 1) → Fin (l + 1) → ℝ)
    (hc : ∀ i j k, 1 ≤ c i j k) (x y z : I) :
    0 < ∑ i, ∑ j, ∑ k,
      c i j k * (bernstein n i x * bernstein m j y * bernstein l k z) := by
  have hunit : (∑ i : Fin (n + 1), ∑ j : Fin (m + 1), ∑ k : Fin (l + 1),
      bernstein n i x * bernstein m j y * bernstein l k z) = 1 := by
    simp_rw [← Finset.mul_sum, bernstein.probability, mul_one]
    simp_rw [← Finset.mul_sum, bernstein.probability, mul_one]
    exact bernstein.probability _ _
  have hsum : 1 ≤ ∑ i, ∑ j, ∑ k,
      c i j k * (bernstein n i x * bernstein m j y * bernstein l k z) := by
    rw [← hunit]
    apply Finset.sum_le_sum
    intro i _
    apply Finset.sum_le_sum
    intro j _
    apply Finset.sum_le_sum
    intro k _
    exact (one_mul _).symm.trans_le (mul_le_mul_of_nonneg_right (hc i j k)
      (mul_nonneg (mul_nonneg bernstein_nonneg bernstein_nonneg) bernstein_nonneg))
  linarith only [hsum]

def hardDelta (x : ℝ) : ℝ := 1 / 4 + (3 / 20) * x

def hardA (y : ℝ) : ℝ := 7 / 20 + y / 40

def hardE (z : ℝ) : ℝ := 1 / 20 + (33 / 500) * z

def hardL (A E u : ℝ) : ℝ := E + (3 * A - 1) * u / 2

def hardJ (A E L w : ℝ) : ℝ :=
  2 * L + (baseDifference A (A + E) - L) * w

def guard (δ A E : ℝ) : ℝ :=
  2 * en δ A E * (2 * A * E - A ^ 2 + 123 / 1000) -
    A * (2 - 5 * A - 2 * E) * Nmax δ A E

