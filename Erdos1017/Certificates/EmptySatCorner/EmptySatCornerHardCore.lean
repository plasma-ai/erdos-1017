theorem guard_chart (x y z : I) :
    0 < guard (hardDelta x) (hardA y) (hardE z) := by
  let coeff : Fin 2 → Fin 4 → Fin 3 → ℝ :=
    fun i j k => (guard_chartPred i j k : ℝ) + 1
  have hpos := tensor3_pos 1 3 2 coeff
    (by intros; dsimp [coeff]; exact le_add_of_nonneg_left (Nat.cast_nonneg _)) x y z
  have hid : (9600000000 : ℝ) * (guard (hardDelta x) (hardA y) (hardE z)) =
      ∑ i : Fin 2, ∑ j : Fin 4, ∑ k : Fin 3, coeff i j k *
        (bernstein 1 i x * bernstein 3 j y * bernstein 2 k z) := by
    norm_num [guard, homogeneousZero, clearedDerivative, clearedMomentEndpoint, gamma, en,
      enFactor, Nmax, b, Bc, P0, baseCredit, baseDifference, edgeMoment, Kq,
      hardDelta, hardA, hardE, hardL, hardJ, coeff, guard_chartPred,
      Fin.sum_univ_succ, bernstein_apply, Nat.choose]
    ring
  rw [← hid] at hpos
  exact (mul_pos_iff_of_pos_left (by norm_num)).mp hpos

def bEval (n : ℕ) (c : Fin (n + 1) → ℝ) (x : I) : ℝ :=
  ∑ i, c i * bernstein n i x

theorem bEval_one_le (n : ℕ) (c : Fin (n + 1) → ℝ)
    (hc : ∀ i, 1 ≤ c i) (x : I) : 1 ≤ bEval n c x := by
  unfold bEval
  calc
    1 = ∑ i : Fin (n + 1), bernstein n i x := (bernstein.probability _ _).symm
    _ ≤ ∑ i : Fin (n + 1), c i * bernstein n i x := by
      apply Finset.sum_le_sum
      intro i _
      exact (one_mul _).symm.trans_le
        (mul_le_mul_of_nonneg_right (hc i) bernstein_nonneg)

theorem bEval_nat_power (n : ℕ) (f : Fin (n + 1) → ℕ) (x : I) :
    bEval n (fun i => (f i : ℝ) + 1) x =
      ∑ k : Fin (n + 1),
        (BernsteinPower.powerCoeff n (fun i => (f i : ℤ) + 1) k.val : ℝ) *
          (x : ℝ) ^ k.val := by
  have h := BernsteinPower.bernstein_eq_of_coeff_eq n
    (fun i => (f i : ℤ) + 1)
    (fun k => BernsteinPower.powerCoeff n (fun i => (f i : ℤ) + 1) k.val)
    (fun _ => rfl) x
  simpa [bEval] using h

