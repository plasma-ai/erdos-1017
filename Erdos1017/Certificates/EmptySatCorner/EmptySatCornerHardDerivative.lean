set_option Elab.async false

set_option maxHeartbeats 20000000 in
set_option maxRecDepth 20000 in
private theorem derivativeStage1_row_0_0_0_0 (w : I) :
    derivativeStage1 0 0 0 0 w = bEval 3 (fun o => (derivativePred 0 0 0 0 o : ℝ) + 1) w := by
  rw [bEval_nat_power 3 (fun o => derivativePred 0 0 0 0 o) w]
  conv_lhs => whnf
  change (_ : ℝ) + _ = _
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero]
  repeat
    conv in (BernsteinPower.powerCoeff _ _ _) => whnf
  repeat
    conv in (derivativePred _ _ _ _ _) => whnf
  norm_num [Nat.choose]
  ring

