private theorem cubicInterpolation_mul (k a b c d x : ℝ) :
    k * cubicInterpolation a b c d x =
      cubicInterpolation (k * a) (k * b) (k * c) (k * d) x := by
  unfold cubicInterpolation
  ring

/-- The exact cleared Lower chart identity. Cubic interpolation checks four
three-variable identities against the stored Horner polynomial. -/
theorem lower_chart_identity (x y z u : ℝ) :
    (1896652800000000000000000000000000000000 : ℝ) *
      homogeneousZero (hardDelta x) (hardA y) (hardE z) (hardL (hardA y) (hardE z) u)
        ((hardL (hardA y) (hardE z) u + hardE z) * hardL (hardA y) (hardE z) u)
        (hardE z) = lowerStage4 x y z u := by
  rw [homogeneousZero_interpolation, lowerStage4_interpolation, cubicInterpolation_mul,
    lower_chart_zero, lower_chart_one, lower_chart_two, lower_chart_three]

