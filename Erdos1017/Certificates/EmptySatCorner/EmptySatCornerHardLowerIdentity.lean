@[expose] public section

noncomputable section

namespace Erdos1017.EmptySatCornerHard

open EmptySatE2

set_option Elab.async false
set_option maxRecDepth 20000
set_option maxHeartbeats 100000000

private def cubicInterpolation (a b c d x : ℝ) : ℝ :=
  a + x * (b - a) + x * (x - 1) / 2 * (c - 2 * b + a) +
    x * (x - 1) * (x - 2) / 6 * (d - 3 * c + 3 * b - a)

private theorem cubic_horner_interpolation (a b c d x : ℝ) :
    a + x * (b + x * (c + x * d)) =
      cubicInterpolation (a + 0 * (b + 0 * (c + 0 * d)))
        (a + 1 * (b + 1 * (c + 1 * d)))
        (a + 2 * (b + 2 * (c + 2 * d)))
        (a + 3 * (b + 3 * (c + 3 * d))) x := by
  unfold cubicInterpolation
  ring

private theorem homogeneousZero_interpolation (A E L n d x : ℝ) :
    homogeneousZero (hardDelta x) A E L n d =
      cubicInterpolation (homogeneousZero (hardDelta 0) A E L n d)
        (homogeneousZero (hardDelta 1) A E L n d)
        (homogeneousZero (hardDelta 2) A E L n d)
        (homogeneousZero (hardDelta 3) A E L n d) x := by
  simp only [cubicInterpolation, homogeneousZero, hardDelta, gamma, en, enFactor, Nmax,
    b, Bc, P0, baseCredit, baseDifference]
  ring

private theorem lowerStage4_interpolation (x y z u : ℝ) :
    lowerStage4 x y z u =
      cubicInterpolation (lowerStage4 0 y z u) (lowerStage4 1 y z u)
        (lowerStage4 2 y z u) (lowerStage4 3 y z u) x := by
  unfold lowerStage4
  apply cubic_horner_interpolation

private theorem lower_chart_zero (y z u : ℝ) :
    (1896652800000000000000000000000000000000 : ℝ) *
      homogeneousZero (hardDelta 0) (hardA y) (hardE z) (hardL (hardA y) (hardE z) u)
        ((hardL (hardA y) (hardE z) u + hardE z) * hardL (hardA y) (hardE z) u)
        (hardE z) = lowerStage4 0 y z u := by
  simp only [lowerStage4, zero_mul, add_zero]
  simp only [homogeneousZero, hardDelta, hardA, hardE, hardL, gamma, en, enFactor,
    Nmax, b, Bc, P0, baseCredit, baseDifference]
  ring

