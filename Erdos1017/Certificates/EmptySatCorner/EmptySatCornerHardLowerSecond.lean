  case «3».«8» => exact lowerStage2_row_3_8 z u
  case «3».«9» => exact lowerStage2_row_3_9 z u

theorem lowerStage2_one_le (i : Fin 4) (j : Fin 10) (z u : I) :
    1 ≤ lowerStage2 i j z u := by
  rw [lowerStage2_eq]
  apply bEval_one_le
  intro k
  exact lowerStage1_one_le i j k u

end Erdos1017.EmptySatCornerHard
