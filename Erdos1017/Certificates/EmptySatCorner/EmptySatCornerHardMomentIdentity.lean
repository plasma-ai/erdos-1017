          (hardL (hardA y) (hardE z) u)
          (hardJ (hardA y) (hardE z) (hardL (hardA y) (hardE z) u) 3))
      ((230400000000000000000000000 : ℝ) *
        clearedMomentEndpoint (hardDelta 3) (hardA y) (hardE z)
          (hardL (hardA y) (hardE z) u)
          (hardJ (hardA y) (hardE z) (hardL (hardA y) (hardE z) u) 4)) w at h
  rw [moment_slice_3_0, moment_slice_3_1, moment_slice_3_2, moment_slice_3_3,
    moment_slice_3_4] at h
  exact h.trans (momentStage5_quartic 3 y z u w).symm

/-- The literal cleared moment formula equals the stored Horner chart.
Cubic and quartic interpolation reduce the coefficient check to three variables. -/
theorem moment_chart_identity (x y z u w : ℝ) :
    (230400000000000000000000000 : ℝ) *
      clearedMomentEndpoint (hardDelta x) (hardA y) (hardE z)
        (hardL (hardA y) (hardE z) u)
        (hardJ (hardA y) (hardE z) (hardL (hardA y) (hardE z) u) w) =
      momentStage5 x y z u w := by
  have h := congrArg (fun t : ℝ => (230400000000000000000000000 : ℝ) * t)
    (clearedMomentEndpoint_cubic (hardA y) (hardE z) (hardL (hardA y) (hardE z) u)
      (hardJ (hardA y) (hardE z) (hardL (hardA y) (hardE z) u) w) x)
  rw [cubic_scale, moment_x_0, moment_x_1, moment_x_2, moment_x_3] at h
  exact h.trans (momentStage5_cubic x y z u w).symm

