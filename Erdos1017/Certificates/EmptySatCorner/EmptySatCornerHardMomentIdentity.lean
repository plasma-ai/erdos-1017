private def cubicInterpolation (a b c d x : ℝ) : ℝ :=
  a + x * (b - a) + x * (x - 1) / 2 * (c - 2 * b + a) +
    x * (x - 1) * (x - 2) / 6 * (d - 3 * c + 3 * b - a)

private def quarticInterpolation (a b c d e x : ℝ) : ℝ :=
  cubicInterpolation a b c d x +
    x * (x - 1) * (x - 2) * (x - 3) / 24 * (e - 4 * d + 6 * c - 4 * b + a)

private theorem cubic_horner_interpolation (a b c d x : ℝ) :
    a + x * (b + x * (c + x * d)) =
      cubicInterpolation (a + 0 * (b + 0 * (c + 0 * d)))
        (a + 1 * (b + 1 * (c + 1 * d)))
        (a + 2 * (b + 2 * (c + 2 * d)))
        (a + 3 * (b + 3 * (c + 3 * d))) x := by
  unfold cubicInterpolation
  ring

private def QuarticInterpolates (f : ℝ → ℝ) : Prop :=
  ∀ x, f x = quarticInterpolation (f 0) (f 1) (f 2) (f 3) (f 4) x

private theorem quartic_horner (a b c d e : ℝ) :
    QuarticInterpolates (fun x => a + x * (b + x * (c + x * (d + x * e)))) := by
  intro x
  unfold quarticInterpolation cubicInterpolation
  ring

private theorem quartic_horner_three (a b c d : ℝ) :
    QuarticInterpolates (fun x => a + x * (b + x * (c + x * d))) := by
  simpa only [mul_zero, add_zero] using quartic_horner a b c d 0

private theorem quartic_horner_two (a b c : ℝ) :
    QuarticInterpolates (fun x => a + x * (b + x * c)) := by
  simpa only [mul_zero, add_zero] using quartic_horner a b c 0 0

private theorem quartic_horner_one (a b : ℝ) :
    QuarticInterpolates (fun x => a + x * b) := by
  simpa only [mul_zero, add_zero] using quartic_horner a b 0 0 0

private theorem quartic_const (a : ℝ) : QuarticInterpolates (fun _ => a) := by
  simpa only [mul_zero, add_zero] using quartic_horner a 0 0 0 0

private theorem quartic_add {f g : ℝ → ℝ}
    (hf : QuarticInterpolates f) (hg : QuarticInterpolates g) :
    QuarticInterpolates (fun x => f x + g x) := by
  intro x
  dsimp only
  rw [hf x, hg x]
  unfold quarticInterpolation cubicInterpolation
  ring

private theorem quartic_const_mul (a : ℝ) {f : ℝ → ℝ}
    (hf : QuarticInterpolates f) : QuarticInterpolates (fun x => a * f x) := by
  intro x
  dsimp only
  rw [hf x]
  unfold quarticInterpolation cubicInterpolation
  ring

private theorem momentStage5_quartic (x y z u : ℝ) :
    QuarticInterpolates (momentStage5 x y z u) := by
  unfold momentStage5
  repeat' first
    | exact quartic_horner _ _ _ _ _
    | exact quartic_horner_three _ _ _ _
    | exact quartic_horner_two _ _ _
    | exact quartic_horner_one _ _
    | exact quartic_const _
    | apply quartic_add
    | apply quartic_const_mul

private theorem clearedMomentEndpoint_cubic (A E L j x : ℝ) :
    clearedMomentEndpoint (hardDelta x) A E L j =
      cubicInterpolation (clearedMomentEndpoint (hardDelta 0) A E L j)
        (clearedMomentEndpoint (hardDelta 1) A E L j)
        (clearedMomentEndpoint (hardDelta 2) A E L j)
        (clearedMomentEndpoint (hardDelta 3) A E L j) x := by
  simp only [cubicInterpolation, clearedMomentEndpoint, hardDelta, gamma, en, Nmax,
    P0, baseCredit, edgeMoment]
  ring

private theorem clearedMomentEndpoint_quartic (δ A E L j t : ℝ) :
    QuarticInterpolates (fun w => clearedMomentEndpoint δ A E L (j + t * w)) := by
  intro w
  simp only [quarticInterpolation, cubicInterpolation, clearedMomentEndpoint, edgeMoment]
  ring

private theorem momentStage5_cubic (x y z u w : ℝ) :
    momentStage5 x y z u w =
      cubicInterpolation (momentStage5 0 y z u w) (momentStage5 1 y z u w)
        (momentStage5 2 y z u w) (momentStage5 3 y z u w) x := by
  unfold momentStage5
  exact cubic_horner_interpolation _ _ _ _ x

private theorem cubic_scale (t a b c d x : ℝ) :
    t * cubicInterpolation a b c d x =
      cubicInterpolation (t * a) (t * b) (t * c) (t * d) x := by
  unfold cubicInterpolation
  ring

private theorem quartic_scale (t a b c d e x : ℝ) :
    t * quarticInterpolation a b c d e x =
      quarticInterpolation (t * a) (t * b) (t * c) (t * d) (t * e) x := by
  unfold quarticInterpolation cubicInterpolation
  ring

