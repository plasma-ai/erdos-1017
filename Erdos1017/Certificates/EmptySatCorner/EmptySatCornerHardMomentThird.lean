set_option maxHeartbeats 20000000 in
set_option maxRecDepth 20000 in
private theorem momentStage3_eq (i : Fin 4) (j : Fin 7) (z u w : I) :
    momentStage3 i j z u w = bEval 6 (fun k => momentStage2 i j k u w) z := by
  fin_cases i <;> fin_cases j
  case «0».«0» => exact momentStage3_row_0_0 z u w
  case «0».«1» => exact momentStage3_row_0_1 z u w
  case «0».«2» => exact momentStage3_row_0_2 z u w
  case «0».«3» => exact momentStage3_row_0_3 z u w
  case «0».«4» => exact momentStage3_row_0_4 z u w
  case «0».«5» => exact momentStage3_row_0_5 z u w
  case «0».«6» => exact momentStage3_row_0_6 z u w
  case «1».«0» => exact momentStage3_row_1_0 z u w
  case «1».«1» => exact momentStage3_row_1_1 z u w
  case «1».«2» => exact momentStage3_row_1_2 z u w
  case «1».«3» => exact momentStage3_row_1_3 z u w
  case «1».«4» => exact momentStage3_row_1_4 z u w
  case «1».«5» => exact momentStage3_row_1_5 z u w
  case «1».«6» => exact momentStage3_row_1_6 z u w
  case «2».«0» => exact momentStage3_row_2_0 z u w
  case «2».«1» => exact momentStage3_row_2_1 z u w
  case «2».«2» => exact momentStage3_row_2_2 z u w
  case «2».«3» => exact momentStage3_row_2_3 z u w
  case «2».«4» => exact momentStage3_row_2_4 z u w
  case «2».«5» => exact momentStage3_row_2_5 z u w
  case «2».«6» => exact momentStage3_row_2_6 z u w
  case «3».«0» => exact momentStage3_row_3_0 z u w
  case «3».«1» => exact momentStage3_row_3_1 z u w
  case «3».«2» => exact momentStage3_row_3_2 z u w
  case «3».«3» => exact momentStage3_row_3_3 z u w
  case «3».«4» => exact momentStage3_row_3_4 z u w
  case «3».«5» => exact momentStage3_row_3_5 z u w
  case «3».«6» => exact momentStage3_row_3_6 z u w

theorem momentStage3_one_le (i : Fin 4) (j : Fin 7) (z u w : I) :
    1 ≤ momentStage3 i j z u w := by
  rw [momentStage3_eq]
  apply bEval_one_le
  intro k
  exact momentStage2_one_le i j k u w

