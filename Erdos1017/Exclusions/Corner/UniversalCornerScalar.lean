  apply (div_le_div_iff₀ (mul_pos hC hpole')
    (mul_pos hC0 (sub_pos.mpr hpole))).mpr
  have hfirst := mul_nonneg (sub_nonneg.mpr hQratio) (sub_nonneg.mpr hpole.le)
  have hsecond := mul_nonneg (show 0 ≤ Q0 * C by positivity)
    (sub_nonneg.mpr hscaleRoot)
  have hid : C0 * (Q0 * (C * (C - Real.sqrt Q)) -
      Q * (C0 * (C0 - r))) =
      (Q0 * C ^ 2 - Q * C0 ^ 2) * (C0 - r) +
        Q0 * C * (r * C - Real.sqrt Q * C0) := by ring
  have hnonneg : 0 ≤ C0 * (Q0 * (C * (C - Real.sqrt Q)) -
      Q * (C0 * (C0 - r))) := by
        rw [hid]
        exact add_nonneg hfirst hsecond
  have := (mul_nonneg_iff_of_pos_left hC0).mp hnonneg
  linarith

