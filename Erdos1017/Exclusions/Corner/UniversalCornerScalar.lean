    have hmul := mul_le_mul_of_nonneg_right hroot (sq_nonneg C)
    have hleft : 0 ≤ Real.sqrt Q * C0 := mul_nonneg hsqrt hC0.le
    have hright : 0 ≤ r * C := mul_nonneg hr hC.le
    nlinarith [sq_nonneg (r * C - Real.sqrt Q * C0)]
  have hpole' : 0 < C - Real.sqrt Q := by
    have hmul := mul_pos (sub_pos.mpr hpole) hC
    nlinarith
