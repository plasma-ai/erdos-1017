private def radicalReciprocal (k Q : ℝ) : ℝ := Q / (k * (k - Real.sqrt Q))
private def radicalFirst (k Q : ℝ) : ℝ :=
  (2 * k - Real.sqrt Q) / (2 * k * (k - Real.sqrt Q) ^ 2)
private def radicalSecond (k Q : ℝ) : ℝ :=
  (3 * k - Real.sqrt Q) / (4 * k * Real.sqrt Q * (k - Real.sqrt Q) ^ 3)

set_option maxHeartbeats 2000000 in
private theorem radical_convex {k M : ℝ} (hk : 0 < k) (_hM : 0 ≤ M)
    (hpole : Real.sqrt M < k) : ConvexOn ℝ (Icc 0 M) (radicalReciprocal k) := by
  have hroot : ∀ x ∈ Icc 0 M, Real.sqrt x < k := by
    intro x hx
    exact (Real.sqrt_le_sqrt hx.2).trans_lt hpole
  have hcontinuous : ContinuousOn (radicalReciprocal k) (Icc 0 M) := by
    unfold radicalReciprocal
    apply continuousOn_id.div
    · exact continuousOn_const.mul (continuousOn_const.sub Real.continuous_sqrt.continuousOn)
    · intro x hx
      exact ne_of_gt (mul_pos hk (sub_pos.mpr (hroot x hx)))
  apply convexOn_of_hasDerivWithinAt2_nonneg (convex_Icc 0 M) hcontinuous
    (f' := radicalFirst k) (f'' := radicalSecond k)
  · intro x hx
    rw [interior_Icc] at hx
    have hr : 0 < Real.sqrt x := Real.sqrt_pos.2 hx.1
    have hgap : 0 < k - Real.sqrt x := sub_pos.mpr (hroot x ⟨hx.1.le, hx.2.le⟩)
    have hs := Real.hasDerivAt_sqrt (ne_of_gt hx.1)
    have hd := (hasDerivAt_id x).div
      ((hasDerivAt_const x k).mul ((hasDerivAt_const x k).sub hs))
      (ne_of_gt (mul_pos hk hgap))
    apply HasDerivAt.hasDerivWithinAt
    convert hd using 1
    · rfl
    · dsimp [radicalFirst]
      field_simp [ne_of_gt hk, ne_of_gt hr, ne_of_gt hgap]
      nlinarith [Real.sq_sqrt hx.1.le]
  · intro x hx
    rw [interior_Icc] at hx
    have hr : 0 < Real.sqrt x := Real.sqrt_pos.2 hx.1
    have hgap : 0 < k - Real.sqrt x := sub_pos.mpr (hroot x ⟨hx.1.le, hx.2.le⟩)
    have hs := Real.hasDerivAt_sqrt (ne_of_gt hx.1)
    have hnum := (hasDerivAt_const x (2 * k)).sub hs
    have hden := (hasDerivAt_const x (2 * k)).mul
      (((hasDerivAt_const x k).sub hs).pow 2)
    have hd := hnum.div hden
      (ne_of_gt (mul_pos (show 0 < 2 * k by positivity) (sq_pos_of_pos hgap)))
    apply HasDerivAt.hasDerivWithinAt
    convert hd using 1
    · rfl
    · dsimp [radicalSecond]
      field_simp [ne_of_gt hk, ne_of_gt hr, ne_of_gt hgap]
      ring
  · intro x hx
    rw [interior_Icc] at hx
    have hr : 0 < Real.sqrt x := Real.sqrt_pos.2 hx.1
    have hgap : 0 < k - Real.sqrt x := sub_pos.mpr (hroot x ⟨hx.1.le, hx.2.le⟩)
    dsimp [radicalSecond]
    have hnum : 0 ≤ 3 * k - Real.sqrt x := by linarith
    positivity

