private theorem affine_convex {D : Set ℝ} (hD : Convex ℝ D) (p v : ℝ) :
    ConvexOn ℝ D (fun eta => p + v * eta) := by
  refine ⟨hD, ?_⟩
  intro x hx y hy t w ht hw htw
  simp only [smul_eq_mul]
  have hp : p * (t + w) = p := by rw [htw, mul_one]
  nlinarith only [hp]

set_option maxHeartbeats 2000000 in
private theorem radical_affine_convex {D : Set ℝ} {k M d p v Q0 Q1 : ℝ}
    (hD : Convex ℝ D) (hd : 0 ≤ d)
    (hg : ConvexOn ℝ (Icc 0 M) (radicalReciprocal k))
    (hQ : ∀ eta ∈ D, Q0 - Q1 * eta ∈ Icc 0 M) :
    ConvexOn ℝ D (fun eta => d * radicalReciprocal k (Q0 - Q1 * eta) + p + v * eta) := by
  refine ⟨hD, ?_⟩
  intro x hx y hy t w ht hw htw
  have hconv := hg.2 (hQ x hx) (hQ y hy) ht hw htw
  simp only [smul_eq_mul] at hconv ⊢
  have hid : Q0 - Q1 * (t * x + w * y) = t * (Q0 - Q1 * x) + w * (Q0 - Q1 * y) := by
    have hQ0 : Q0 * (t + w) = Q0 := by rw [htw, mul_one]
    nlinarith only [hQ0]
  rw [hid]
  have hmul := mul_nonneg hd (sub_nonneg.mpr hconv)
  have hp : p * (t + w) = p := by rw [htw, mul_one]
  nlinarith only [hmul, hp]

