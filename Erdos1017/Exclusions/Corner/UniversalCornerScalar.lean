private theorem rectangle_polynomials {A ell : ℝ}
    (hA : A ∈ Icc (1 / 3 : ℝ) (369 / 1000))
    (hell : ell ∈ Icc (363 / 589 : ℝ) (9 / 11)) :
    0 < errorThreeFifths A ell ∧ 0 < errorOneTwentyfifth A ell ∧
      29889 / 12100000 < zeroPrice A ell ∧
      0 < momentLower A ell ∧ 0 < momentUpper A ell := by
  let u : I := ⟨(3000 / 107 : ℝ) * (A - 1 / 3), by
    constructor <;> linarith [hA.1, hA.2]⟩
  let v : I := ⟨(6479 / 1308 : ℝ) * (ell - 363 / 589), by
    constructor <;> linarith [hell.1, hell.2]⟩
  have hu : a + (369 / 1000 - a) * (u : ℝ) = A := by dsimp [u, a]; ring
  have hv : ellLower + (ellUpper - ellLower) * (v : ℝ) = ell := by
    dsimp [v, ellLower, ellUpper]
    ring
  exact ⟨by simpa only [hu, hv, zero_div] using errorThreeFifths_chart u v,
    by simpa only [hu, hv, zero_div] using errorOneTwentyfifth_chart u v,
    by simpa only [hu, hv, zero_div] using zeroPrice_chart u v,
    by simpa only [hu, hv, zero_div] using momentLower_chart u v,
    by simpa only [hu, hv, zero_div] using momentUpper_chart u v⟩

private theorem base_signs {A ell : ℝ}
    (hA : A ∈ Icc (1 / 3 : ℝ) (369 / 1000))
    (hell : ell ∈ Icc (363 / 589 : ℝ) (9 / 11)) :
    57 / 1000 < gammaZero ell ∧ 0 < rowZero A ell ∧ 0 < radZero A ell := by
  have hg : (57 / 1000 : ℝ) < gammaZero ell := by
    dsimp [gammaZero, gConst, hUpper]
    linarith only [hell.2]
  have hr : 0 < rowZero A ell := by
    have hp := mul_nonneg (show 0 ≤ ell - 363 / 589 by linarith only [hell.1])
      (show 0 ≤ 1 - A by linarith only [hA.2])
    dsimp only [rowZero]
    nlinarith only [hp, hg, hA.2]
  have hR : 0 < radZero A ell := by
    have hp := mul_nonneg (show 0 ≤ 2 * ell - 1 by linarith only [hell.1])
      (show 0 ≤ A by linarith only [hA.1])
    dsimp only [radZero]
    linarith only [hp, hg]
  exact ⟨hg, hr, hR⟩

private theorem coarse_error_bounds {A ell gamma u : ℝ}
    (hA : A ∈ Icc (1 / 3 : ℝ) (369 / 1000))
    (hell : ell ∈ Icc (363 / 589 : ℝ) (9 / 11))
    (hgamma : gammaZero ell < gamma) (hu : u < 1 - 2 * A)
    (hrow : ell + gamma - (1 + ell) * A ≤ 2 * ell * u) :
    let RP := ell + gamma - (1 + ell) * A
    let RR := (2 * ell - 1) * A + 3 * gamma
    let D := 2 * ell * (1 - 2 * A) - RP
    max (A - 3 * gamma) 0 * D ^ 2 / (4 * RP * RR) < 3 * gamma / 5 ∧
      max (A - 3 * gamma) 0 * D ^ 2 / (4 * RP * RR) < 1 / 25 := by
  dsimp only
  let RP := ell + gamma - (1 + ell) * A
  let RR := (2 * ell - 1) * A + 3 * gamma
  let D := 2 * ell * (1 - 2 * A) - RP
  change max (A - 3 * gamma) 0 * D ^ 2 / (4 * RP * RR) < 3 * gamma / 5 ∧
    max (A - 3 * gamma) 0 * D ^ 2 / (4 * RP * RR) < 1 / 25
  obtain ⟨hg, hr, hR⟩ := base_signs hA hell
  have hgpos : 0 < gamma := by linarith only [hg, hgamma]
  have hrle : rowZero A ell ≤ RP := by dsimp [rowZero, RP]; linarith only [hgamma]
  have hRle : radZero A ell ≤ RR := by dsimp [radZero, RR]; linarith only [hgamma]
  have hRP : 0 < RP := hr.trans_le hrle
  have hRR : 0 < RR := hR.trans_le hRle
  have hden : 0 < 4 * RP * RR := by positivity
  by_cases hT : 0 < A - 3 * gamma
  · have hD : 0 < D := by
      have hp := mul_pos (show 0 < 2 * ell by linarith only [hell.1])
        (sub_pos.mpr hu)
      dsimp only [D, RP]
      linarith only [hp, hrow]
    have hDle : D ≤ defectZero A ell := by
      dsimp [D, RP, defectZero, rowZero]
      linarith only [hgamma]
    have hD0 : 0 ≤ defectZero A ell := hD.le.trans hDle
    have hsquare : D ^ 2 ≤ (defectZero A ell) ^ 2 := by
      nlinarith only [mul_nonneg (sub_nonneg.mpr hDle) (add_nonneg hD.le hD0)]
    have hTle : A - 3 * gamma ≤ A - 3 * gammaZero ell := by linarith only [hgamma]
    have hnum : (A - 3 * gamma) * D ^ 2 ≤
        (A - 3 * gammaZero ell) * (defectZero A ell) ^ 2 :=
      mul_le_mul hTle hsquare (sq_nonneg _) (hT.le.trans hTle)
    have hprod : rowZero A ell * radZero A ell ≤ RP * RR :=
      mul_le_mul hrle hRle hR.le hRP.le
    have hgprod : gammaZero ell * (rowZero A ell * radZero A ell) ≤ gamma * (RP * RR) :=
      mul_le_mul hgamma.le hprod (mul_nonneg hr.le hR.le) hgpos.le
    have hpolys := rectangle_polynomials hA hell
    have hp1 : (A - 3 * gammaZero ell) * (defectZero A ell) ^ 2 <
        (12 / 5) * gammaZero ell * rowZero A ell * radZero A ell := by
      have hp := hpolys.1
      dsimp only [errorThreeFifths] at hp
      linarith only [hp]
    have hp2 : (A - 3 * gammaZero ell) * (defectZero A ell) ^ 2 <
        (4 / 25) * rowZero A ell * radZero A ell := by
      have hp := hpolys.2.1
      dsimp only [errorOneTwentyfifth] at hp
      linarith only [hp]
    rw [max_eq_left hT.le]
    constructor
    · apply (div_lt_iff₀ hden).mpr
      nlinarith only [hnum, hp1, hgprod]
    · apply (div_lt_iff₀ hden).mpr
      nlinarith only [hnum, hp2, hprod]
  · rw [max_eq_right (le_of_not_gt hT)]
    simp only [zero_mul, zero_div]
    constructor
    · positivity
    · norm_num

private theorem zero_price_gap {A ell gamma u R : ℝ}
    (hA : A ∈ Icc (1 / 3 : ℝ) (369 / 1000))
    (hell : ell ∈ Icc (363 / 589 : ℝ) (9 / 11))
    (hgamma : gammaZero ell < gamma) (hR : 0 ≤ R)
    (hcap : R ≤ (1 - u - 2 * ell * A - 3 * gamma) / ell)
    (hrow : ell + gamma - (1 + ell) * A ≤ 2 * ell * u) :
    1 / 200 < gamma - max (1 - 2 * (3 * gamma / A - (1 - ell))) 0 * R := by
  let theta := 3 * gamma / A - (1 - ell)
  have hApos : 0 < A := by linarith only [hA.1]
  have hellpos : 0 < ell := by linarith only [hell.1]
  have hg : (57 / 1000 : ℝ) < gamma := (base_signs hA hell).1.trans hgamma
  change 1 / 200 < gamma - max (1 - 2 * theta) 0 * R
  by_cases ht : 1 - 2 * theta ≤ 0
  · rw [max_eq_right ht, zero_mul, sub_zero]
    linarith only [hg]
  · have ht : 0 < 1 - 2 * theta := lt_of_not_ge ht
    rw [max_eq_left ht.le]
    let P := (3 - 2 * ell) * A - 6 * gamma
    let P0 := (3 - 2 * ell) * A - 6 * gammaZero ell
    let Q := ell + A * (1 + ell - 4 * ell ^ 2) - gamma * (1 + 6 * ell)
    let Q0 := ell + A * (1 + ell - 4 * ell ^ 2) - gammaZero ell * (1 + 6 * ell)
    let den := 2 * ell ^ 2 * A
    have hden : 0 < den := by dsimp only [den]; positivity
    have hid : A * (1 - 2 * theta) = P := by
      dsimp only [theta, P]
      field_simp
      ring
    have hP : 0 < P := by rw [← hid]; exact mul_pos hApos ht
    have hQbound : 2 * ell ^ 2 * R ≤ Q := by
      have hh := (le_div_iff₀ hellpos).mp hcap
      have hp := mul_le_mul_of_nonneg_left hh (show 0 ≤ 2 * ell by positivity)
      dsimp only [Q]
      nlinarith only [hp, hrow]
    have hQ : 0 ≤ Q := by nlinarith only [hQbound, mul_nonneg (sq_nonneg ell) hR]
    have hPbound : P ≤ P0 := by dsimp only [P, P0]; linarith only [hgamma]
    have hQle : Q ≤ Q0 := by
      have hp := mul_nonneg (sub_nonneg.mpr hgamma.le) (show 0 ≤ 1 + 6 * ell by positivity)
      dsimp only [Q, Q0]
      nlinarith only [hp]
    have hprod : P * Q ≤ P0 * Q0 :=
      mul_le_mul hPbound hQle hQ (hP.le.trans hPbound)
    have hrowpay := mul_le_mul_of_nonneg_left hQbound hP.le
    have hgpay := mul_le_mul_of_nonneg_left hgamma.le hden.le
    have hpoly := (rectangle_polynomials hA hell).2.2.1
    change 29889 / 12100000 < den * gammaZero ell - P0 * Q0 at hpoly
    have hsquare : ell ^ 2 ≤ (9 / 11 : ℝ) ^ 2 := by
      nlinarith only [mul_nonneg (sub_nonneg.mpr hell.2)
        (show 0 ≤ 9 / 11 + ell by positivity)]
    have hmul := mul_le_mul hsquare hA.2 hApos.le (sq_nonneg (9 / 11 : ℝ))
    have hfloor : den / 200 ≤ (29889 / 12100000 : ℝ) := by
      dsimp only [den]
      nlinarith only [hmul]
    have hidentity : den * (gamma - (1 - 2 * theta) * R) =
        den * gamma - 2 * ell ^ 2 * P * R := by
      have heq := congrArg (fun x : ℝ => 2 * ell ^ 2 * x * R) hid
      dsimp only [den]
      nlinarith only [heq]
    have hpositive : den * (1 / 200) < den * (gamma - (1 - 2 * theta) * R) := by
      nlinarith only [hrowpay, hgpay, hprod, hpoly, hfloor, hidentity]
    exact (mul_lt_mul_iff_right₀ hden).mp hpositive

private theorem quadratic_positive {c0 c1 c2 l r x : ℝ}
    (hlr : l < r) (hx : x ∈ Icc l r) (hc2 : c2 ≤ 0)
    (hl : 0 < c0 + c1 * l + c2 * l ^ 2)
    (hr : 0 < c0 + c1 * r + c2 * r ^ 2) :
    0 < c0 + c1 * x + c2 * x ^ 2 := by
  by_cases hxr : x < r
  · have hleft := mul_pos (sub_pos.mpr hxr) hl
    have hright := mul_nonneg (sub_nonneg.mpr hx.1) hr.le
    have hcurve := mul_nonneg (neg_nonneg.mpr hc2)
      (mul_nonneg (sub_nonneg.mpr hlr.le)
        (mul_nonneg (sub_nonneg.mpr hx.1) (sub_nonneg.mpr hx.2)))
    have hid : (r - l) * (c0 + c1 * x + c2 * x ^ 2) =
        (r - x) * (c0 + c1 * l + c2 * l ^ 2) +
          (x - l) * (c0 + c1 * r + c2 * r ^ 2) -
            c2 * (r - l) * (x - l) * (r - x) := by ring
    have hp : 0 < (r - l) * (c0 + c1 * x + c2 * x ^ 2) := by
      nlinarith only [hleft, hright, hcurve, hid]
    exact (mul_pos_iff_of_pos_left (sub_pos.mpr hlr)).mp hp
  · have heq : x = r := le_antisymm hx.2 (le_of_not_gt hxr)
    simpa only [heq] using hr

private theorem deficit_moment_bound {A b u ell gamma h z q DH : ℝ}
    (hA : A ∈ Ioo (1 / 3 : ℝ) (369 / 1000))
    (hell : ell ∈ Icc (363 / 589 : ℝ) (9 / 11))
    (hgamma : gammaZero ell < gamma) (hh : h ≤ hUpper)
    (hbcap : b ≤ 1 - 2 * A)
    (hu : u < 1 - 2 * A) (hrow : ell + gamma - (1 + ell) * A ≤ 2 * ell * u)
    (hzcap : z ≤ 1 - 3 * A + b) (hq : 0 ≤ q)
    (hholes : q + z ^ 2 ≤ h - A ^ 2 - b ^ 2 - 2 * b * (1 - A - b - u))
    (hDH : DH ≤ (1 - ell) * (1 - u) - 2 * gamma) :
    DH < (3 * gamma / A - (1 - ell)) * (A - z) := by
  let eps := 3 * A - 1
  let eta := 1 - A - b - u
  let s0 := 2 - 4 * A
  let den := 2 * (s0 - u)
  let Kc := 18 * A - 22 * A ^ 2 - 3 - hUpper
  let Ku := 2 - 8 * A
  have hApos : 0 < A := by linarith only [hA.1]
  have hellpos : 0 < ell := by linarith only [hell.1]
  have hdelta : 0 ≤ 1 - ell := by linarith only [hell.2]
  have heps : 0 < eps := by dsimp only [eps]; linarith only [hA.1]
  have heta : 0 < eta := by dsimp only [eta]; linarith only [hA.1, hbcap, hu]
  have hden : 0 < den := by dsimp only [den, s0]; linarith only [hu, hA.2]
  have hk : 0 < A - z := by linarith only [hzcap, hbcap, hA.1]
  have hbeps : eps + z ≤ b := by dsimp only [eps]; linarith only [hzcap]
  have hdiff :
      (eps + z) ^ 2 + 2 * (eps + z) * (1 - A - eps - z - u) ≤
        b ^ 2 + 2 * b * eta := by
    have hp := mul_nonneg (sub_nonneg.mpr hbeps)
      (show 0 ≤ 2 * eta + (b - (eps + z)) by linarith only [heta, hbeps])
    dsimp only [eta] at hp ⊢
    nlinarith only [hp]
  have hhole : A ^ 2 + b ^ 2 + 2 * b * eta + z ^ 2 ≤ h := by
    dsimp only [eta]
    linarith only [hholes, hq]
  have hzbound : den * z ≤ hUpper - A ^ 2 + eps ^ 2 -
      2 * eps * (1 - A - u) := by
    dsimp only [eps, den, s0, eta] at hdiff hhole ⊢
    nlinarith only [hdiff, hhole, hh]
  have hinventory : Kc + Ku * u ≤ den * (A - z) := by
    have hid : den * A - (hUpper - A ^ 2 + eps ^ 2 -
        2 * eps * (1 - A - u)) = Kc + Ku * u := by
      dsimp only [den, s0, eps, Kc, Ku]
      ring
    nlinarith only [hid, hzbound]
  obtain ⟨hg, _, _⟩ := base_signs ⟨hA.1.le, hA.2.le⟩ hell
  have hAdelta : A * (1 - ell) ≤ (369 / 1000 : ℝ) * (226 / 589) :=
    mul_le_mul hA.2.le (by linarith only [hell.1]) hdelta (by norm_num)
  have hthetaNum : 0 < 3 * gammaZero ell - A * (1 - ell) := by
    nlinarith only [hg, hAdelta]
  let l := rowZero A ell / (2 * ell)
  let r := 1 - 2 * A
  have hlu : l ≤ u := by
    apply (div_le_iff₀ (show 0 < 2 * ell by positivity)).mpr
    dsimp only [rowZero]
    nlinarith only [hrow, hgamma]
  have hur : u < r := hu
  have hlr : l < r := hlu.trans_lt hur
  have hpolys := rectangle_polynomials ⟨hA.1.le, hA.2.le⟩ hell
  have hleft : 0 < momentG0 A ell + momentG1 A ell * l + momentG2 A ell * l ^ 2 := by
    apply (mul_pos_iff_of_pos_left (show 0 < 4 * ell ^ 2 by positivity)).mp
    have hid : 4 * ell ^ 2 *
        (momentG0 A ell + momentG1 A ell * l + momentG2 A ell * l ^ 2) =
        momentLower A ell := by
      dsimp only [l, momentLower]
      field_simp
      ring
    rw [hid]
    exact hpolys.2.2.2.1
  have hright : 0 < momentG0 A ell + momentG1 A ell * r + momentG2 A ell * r ^ 2 := by
    convert hpolys.2.2.2.2 using 1
    dsimp only [momentUpper, r]
    ring
  have hquadratic := quadratic_positive hlr ⟨hlu, hur.le⟩
    (show momentG2 A ell ≤ 0 by
      dsimp only [momentG2]
      nlinarith only [mul_nonneg hApos.le hdelta]) hleft hright
  have hproduct := mul_le_mul_of_nonneg_left hinventory hthetaNum.le
  have hid : (3 * gammaZero ell - A * (1 - ell)) * (Kc + Ku * u) -
      den * A * ((1 - ell) * (1 - u) - 2 * gammaZero ell) =
      momentG0 A ell + momentG1 A ell * u + momentG2 A ell * u ^ 2 := by
    dsimp only [den, s0, Kc, Ku, momentG0, momentG1, momentG2]
    ring
  have hbase : 0 < (3 * gammaZero ell - A * (1 - ell)) * (A - z) -
      A * ((1 - ell) * (1 - u) - 2 * gammaZero ell) := by
    apply (mul_pos_iff_of_pos_left hden).mp
    nlinarith only [hquadratic, hid, hproduct]
  have hgain := mul_pos (sub_pos.mpr hgamma)
    (show 0 < 3 * (A - z) + 2 * A by linarith only [hk, hApos])
  have hactual : 0 < (3 * gamma - A * (1 - ell)) * (A - z) -
      A * ((1 - ell) * (1 - u) - 2 * gamma) := by
    nlinarith only [hbase, hgain]
  have htheta : A * (3 * gamma / A - (1 - ell)) = 3 * gamma - A * (1 - ell) := by
    field_simp
  have hmul := congrArg (fun x : ℝ => x * (A - z)) htheta
  have hresult : (1 - ell) * (1 - u) - 2 * gamma <
      (3 * gamma / A - (1 - ell)) * (A - z) := by
    apply (mul_lt_mul_iff_right₀ hApos).mp
    nlinarith only [hactual, hmul]
  exact hDH.trans_lt hresult

/-- Exact corner scalar licenses for the error, zero price and one joint
hole-deficit inventory. All own-parameter and denominator signs are derived. -/
theorem price_licenses {A b u h ell c z q DH : ℝ}
    (hA : A ∈ Ioo (1 / 3 : ℝ) (369 / 1000))
    (hell : ell ∈ Icc (363 / 589 : ℝ) (9 / 11))
    (hh : h < 23243417 / 10 ^ 8)
    (hc : 138261458236451 / 1116960975000000 < c)
    (hbcap : b ≤ 1 - 2 * A) (hu : u ∈ Ico (0 : ℝ) (1 - 2 * A))
    (hrow : ell + (2 * c - ell * h) - (1 + ell) * A ≤ 2 * ell * u)
    (hDH : DH ∈ Icc (0 : ℝ) ((1 - ell) * (1 - u) - 2 * (2 * c - ell * h)))
    (hz : z ∈ Icc (0 : ℝ) (min (1 - 3 * A + b)
      ((1 - u - 2 * ell * A - 3 * (2 * c - ell * h)) / ell)))
    (hq : 0 ≤ q)
    (hholes : q + z ^ 2 ≤ h - A ^ 2 - b ^ 2 - 2 * b * (1 - A - b - u)) :
    let gamma := 2 * c - ell * h
    let RP := ell + gamma - (1 + ell) * A
    let RR := (2 * ell - 1) * A + 3 * gamma
    let D := 2 * ell * (1 - 2 * A) - RP
    let Ecap := max (A - 3 * gamma) 0 * D ^ 2 / (4 * RP * RR)
    let theta := 3 * gamma / A - (1 - ell)
    let Rcap := min (1 - 3 * A + b) ((1 - u - 2 * ell * A - 3 * gamma) / ell)
    Ecap < 3 * gamma / 5 ∧ Ecap < 1 / 25 ∧
      1 / 200 < gamma - max (1 - 2 * theta) 0 * Rcap ∧
      DH < theta * (A - z) := by
  let gamma := 2 * c - ell * h
  have hellpos : 0 < ell := by linarith only [hell.1]
  have hgamma : gammaZero ell < gamma := by
    have hp := mul_pos hellpos (sub_pos.mpr hh)
    dsimp only [gammaZero, gConst, hUpper, gamma]
    nlinarith only [hp, hc]
  have herrors := coarse_error_bounds ⟨hA.1.le, hA.2.le⟩ hell hgamma hu.2 hrow
  have hzero := zero_price_gap ⟨hA.1.le, hA.2.le⟩ hell hgamma (hz.1.trans hz.2)
    (min_le_right _ _) hrow
  have hmoment := deficit_moment_bound hA hell hgamma hh.le hbcap hu.2 hrow
    (hz.2.trans (min_le_left _ _)) hq hholes hDH.2
  exact ⟨herrors.1, herrors.2, hzero, hmoment⟩

/-- The nonpositive price, including equality, conflicts with the actual
corner bracket and the raw integrated copy inequality. -/
theorem nonpositive_price_false {A b ell h c Ecap N n : ℝ}
    (hA : 1 / 3 < A) (hell : ell ∈ Icc (363 / 589 : ℝ) (9 / 11))
    (hh : h < 23243417 / 10 ^ 8)
    (hc : 138261458236451 / 1116960975000000 < c)
    (hprice : b * ell ≤ 2 * c - ell * h)
    (htheta : 3 * (2 * c - ell * h) / A - (1 - ell) < 1)
    (hE : Ecap < 1 / 25) (hN : 0 < N) (hNn : N < ell * n)
    (hcopy : (2 * c - ell * h - Ecap) * n ≤ (1 - 4 * A + 2 * b) * N) : False := by
  let gamma := 2 * c - ell * h
  have hApos : 0 < A := by linarith only [hA]
  have hellpos : 0 < ell := by linarith only [hell.1]
  have hgamma : (57 / 1000 : ℝ) < gamma := by
    have hp := mul_pos hellpos (sub_pos.mpr hh)
    have hq := mul_nonneg (sub_nonneg.mpr hell.2)
      (by norm_num : (0 : ℝ) ≤ 23243417 / 10 ^ 8)
    dsimp only [gamma]
    nlinarith only [hp, hq, hc]
  have hn : 0 < n := by nlinarith only [hN, hNn, hellpos]
  have hgammaE : 0 < gamma - Ecap := by linarith only [hgamma, hE]
  have hcoefficient : 0 < 1 - 4 * A + 2 * b := by
    by_contra hnot
    have hp := mul_nonpos_of_nonpos_of_nonneg (le_of_not_gt hnot) hN.le
    have hq := mul_pos hgammaE hn
    change (gamma - Ecap) * n ≤ (1 - 4 * A + 2 * b) * N at hcopy
    linarith only [hp, hq, hcopy]
  have hstrict := mul_lt_mul_of_pos_left hNn hcoefficient
  have hraw : gamma - Ecap < ell * (1 - 4 * A + 2 * b) := by
    by_contra hnot
    have hp := mul_le_mul_of_nonneg_right (le_of_not_gt hnot) hn.le
    change (gamma - Ecap) * n ≤ (1 - 4 * A + 2 * b) * N at hcopy
    nlinarith only [hp, hstrict, hcopy]
  have htheta' : 3 * gamma < A * (2 - ell) := by
    have hdiv : 3 * gamma / A < 2 - ell := by
      dsimp only [gamma]
      linarith only [htheta]
    have hmul := (div_lt_iff₀ hApos).mp hdiv
    nlinarith only [hmul]
  have hprice' : b * ell ≤ gamma := hprice
  have hgap := mul_pos hellpos (show 0 < 3 * A - 1 by linarith only [hA])
  have hfirst : A * (4 * ell - 2) / 3 < Ecap := by
    nlinarith only [hraw, htheta', hprice', hgap]
  have hmul := mul_nonneg (show 0 ≤ A - 1 / 3 by linarith only [hA])
    (show 0 ≤ 4 * ell - 2 by linarith only [hell.1])
  nlinarith only [hfirst, hmul, hell.1, hE]

/- The positive-price argument keeps one joint hole budget while enlarging the state domain. -/

set_option maxHeartbeats 2000000 in
private theorem chart_positive {P : ℝ → ℝ → ℝ} {lo hi b z : ℝ} {cap : ℝ → ℝ}
    (hchart : ∀ u v : I,
      0 < P (lo + (hi - lo) * (u : ℝ))
        (cap (lo + (hi - lo) * (u : ℝ)) * (v : ℝ)))
    (hlt : lo < hi) (hb : b ∈ Icc lo hi) (hc : 0 < cap b)
    (hz : z ∈ Icc 0 (cap b)) : 0 < P b z := by
  let u : I := ⟨(b - lo) / (hi - lo), by
    constructor
    · exact div_nonneg (sub_nonneg.mpr hb.1) (sub_nonneg.mpr hlt.le)
    · exact (div_le_one (sub_pos.mpr hlt)).mpr (by linarith [hb.2])⟩
  let v : I := ⟨z / cap b, div_nonneg hz.1 hc.le,
    (div_le_one hc).mpr hz.2⟩
  have hu : lo + (hi - lo) * (u : ℝ) = b := by
    dsimp [u]
    field_simp [ne_of_gt (sub_pos.mpr hlt)]
    ring
  have hv : cap b * (v : ℝ) = z := by
    dsimp [v]
    field_simp
  simpa only [hu, hv] using hchart u v

set_option maxHeartbeats 2000000 in
private theorem square_sign_bound {k d eta Q T C : ℝ}
    (hk : 0 < k) (hd : 0 ≤ d) (hQ : 0 ≤ Q)
    (hD : 0 < T * k - d * eta)
    (hP : 0 < k * (T * k - d * eta) - d * Q)
    (hS : 0 < (k * (T * k - d * eta) - d * Q) ^ 2 -
      (T * k - d * eta) ^ 2 * Q) :
    d * (eta / k + Q / (k * (k - min C (Real.sqrt Q)))) < T := by
  let D := T * k - d * eta
  let P := k * D - d * Q
  have hD' : 0 < D := hD
  have hP' : 0 < P := hP
  have hS' : 0 < P ^ 2 - D ^ 2 * Q := hS
  have hr := Real.sqrt_nonneg Q
  have hr2 := Real.sq_sqrt hQ
  have hdr : 0 ≤ D * Real.sqrt Q := mul_nonneg hD'.le hr
  have hPr : D * Real.sqrt Q < P := by
    nlinarith [sq_nonneg (P - D * Real.sqrt Q)]
  have hgap : d * Q < D * (k - Real.sqrt Q) := by
    dsimp [P] at hPr
    nlinarith
  have hroot : 0 < k - Real.sqrt Q := by
    by_contra! hneg
    have := mul_nonpos_of_nonneg_of_nonpos hD'.le hneg
    linarith [mul_nonneg hd hQ]
  have hmin : 0 < k - min C (Real.sqrt Q) :=
    lt_of_lt_of_le hroot (sub_le_sub_left (min_le_right _ _) k)
  have hden : 0 < k * (k - Real.sqrt Q) := mul_pos hk hroot
  have hdenMin : 0 < k * (k - min C (Real.sqrt Q)) := mul_pos hk hmin
  have hcorr : Q / (k * (k - min C (Real.sqrt Q))) ≤
      Q / (k * (k - Real.sqrt Q)) := by
    apply div_le_div_of_nonneg_left hQ hden
    exact mul_le_mul_of_nonneg_left (sub_le_sub_left (min_le_right _ _) k) hk.le
  have hraw : d * (eta / k + Q / (k * (k - Real.sqrt Q))) < T := by
    have hid : (T - d * (eta / k + Q / (k * (k - Real.sqrt Q)))) /
        1 = (P - D * Real.sqrt Q) / (k * (k - Real.sqrt Q)) := by
      dsimp [P, D]
      field_simp
      ring
    have hpos : 0 < (P - D * Real.sqrt Q) / (k * (k - Real.sqrt Q)) :=
      div_pos (sub_pos.mpr hPr) hden
    rw [← hid] at hpos
    simpa only [div_one, sub_pos] using hpos
  exact lt_of_le_of_lt (mul_le_mul_of_nonneg_left (add_le_add le_rfl hcorr) hd) hraw

private def moment (b z eta : ℝ) : ℝ := hUpper - a ^ 2 - b ^ 2 - z ^ 2 - 2 * b * eta

private def reduced (b z eta : ℝ) : ℝ :=
  (b - bZero) * (eta / (a - z) + moment b z eta /
    ((a - z) * (a - z - min (a - b) (Real.sqrt (moment b z eta))))) +
  7 * z / 18 + 11 * min b ((eta + b - tZero) / ellUpper) / 18 -
  (a - b) - 2 * bZero / 5

set_option maxHeartbeats 2000000 in
private theorem lower_chart_signs {b z : ℝ} (hb : b ∈ Icc bZero (1 / 4))
    (hz : z ∈ Icc 0 b) (hQ : 0 ≤ lowerQ b z) :
