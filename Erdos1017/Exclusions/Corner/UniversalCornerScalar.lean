private theorem negative_with_two_cuts {f : ℝ → ℝ} {l r u v x : ℝ}
    (h00 : ConvexOn ℝ (Icc l r ∩ Iic u ∩ Iic v) f)
    (h01 : ConvexOn ℝ (Icc l r ∩ Iic u ∩ Ici v) f)
    (h10 : ConvexOn ℝ (Icc l r ∩ Ici u ∩ Iic v) f)
    (h11 : ConvexOn ℝ (Icc l r ∩ Ici u ∩ Ici v) f)
    (hl : f l < 0) (hr : f r < 0)
    (hu : u ∈ Icc l r → f u < 0) (hv : v ∈ Icc l r → f v < 0)
    (hx : x ∈ Icc l r) : f x < 0 := by
  have hn {y : ℝ} (hy : y ∈ Icc l r) (he : y = l ∨ y = r ∨ y = u ∨ y = v) :
      f y < 0 := by
    rcases he with rfl | rfl | rfl | rfl
    · exact hl
    · exact hr
    · exact hu hy
    · exact hv hy
  have hmin (a b : ℝ) : min a b = a ∨ min a b = b := by
    rcases le_total a b with h | h
    · exact Or.inl (min_eq_left h)
    · exact Or.inr (min_eq_right h)
  have hmax (a b : ℝ) : max a b = a ∨ max a b = b := by
    rcases le_total b a with h | h
    · exact Or.inl (max_eq_left h)
    · exact Or.inr (max_eq_right h)
  have hlr : l ≤ r := hx.1.trans hx.2
  by_cases hxu : x ≤ u
  · by_cases hxv : x ≤ v
    · let b := min r (min u v)
      have hxb : x ≤ b := le_min hx.2 (le_min hxu hxv)
      have hb : b ∈ Icc l r := ⟨hx.1.trans hxb, min_le_left _ _⟩
      have hbu : b ≤ u := (min_le_right _ _).trans (min_le_left _ _)
      have hbv : b ≤ v := (min_le_right _ _).trans (min_le_right _ _)
      have hfb : f b < 0 := by
        rcases hmin r (min u v) with he | he
        · exact hn hb (Or.inr (Or.inl he))
        · rcases hmin u v with he' | he'
          · exact hn hb (Or.inr (Or.inr (Or.inl (he.trans he'))))
          · exact hn hb (Or.inr (Or.inr (Or.inr (he.trans he'))))
      exact (h00.le_max_of_mem_Icc
        ⟨⟨⟨le_rfl, hlr⟩, hx.1.trans hxu⟩, hx.1.trans hxv⟩
        ⟨⟨hb, hbu⟩, hbv⟩ ⟨hx.1, hxb⟩).trans_lt (max_lt hl hfb)
    · let a := max l v
      let b := min r u
      have hax : a ≤ x := max_le hx.1 (le_of_not_ge hxv)
      have hxb : x ≤ b := le_min hx.2 hxu
      have ha : a ∈ Icc l r := ⟨le_max_left _ _, hax.trans hx.2⟩
      have hb : b ∈ Icc l r := ⟨hx.1.trans hxb, min_le_left _ _⟩
      have hfa : f a < 0 := by
        rcases hmax l v with he | he
        · exact hn ha (Or.inl he)
        · exact hn ha (Or.inr (Or.inr (Or.inr he)))
      have hfb : f b < 0 := by
        rcases hmin r u with he | he
        · exact hn hb (Or.inr (Or.inl he))
        · exact hn hb (Or.inr (Or.inr (Or.inl he)))
      exact (h01.le_max_of_mem_Icc
        ⟨⟨ha, hax.trans hxu⟩, show v ≤ a from le_max_right l v⟩
        ⟨⟨hb, show b ≤ u from min_le_right r u⟩, (le_of_not_ge hxv).trans hxb⟩
        ⟨hax, hxb⟩).trans_lt (max_lt hfa hfb)
  · by_cases hxv : x ≤ v
    · let a := max l u
      let b := min r v
      have hax : a ≤ x := max_le hx.1 (le_of_not_ge hxu)
      have hxb : x ≤ b := le_min hx.2 hxv
      have ha : a ∈ Icc l r := ⟨le_max_left _ _, hax.trans hx.2⟩
      have hb : b ∈ Icc l r := ⟨hx.1.trans hxb, min_le_left _ _⟩
      have hfa : f a < 0 := by
        rcases hmax l u with he | he
        · exact hn ha (Or.inl he)
        · exact hn ha (Or.inr (Or.inr (Or.inl he)))
      have hfb : f b < 0 := by
        rcases hmin r v with he | he
        · exact hn hb (Or.inr (Or.inl he))
        · exact hn hb (Or.inr (Or.inr (Or.inr he)))
      exact (h10.le_max_of_mem_Icc
        ⟨⟨ha, show u ≤ a from le_max_right l u⟩, hax.trans hxv⟩
        ⟨⟨hb, (le_of_not_ge hxu).trans hxb⟩, show b ≤ v from min_le_right r v⟩
        ⟨hax, hxb⟩).trans_lt (max_lt hfa hfb)
    · let a := max l (max u v)
      have hax : a ≤ x := max_le hx.1 (max_le (le_of_not_ge hxu) (le_of_not_ge hxv))
      have ha : a ∈ Icc l r := ⟨le_max_left _ _, hax.trans hx.2⟩
      have hau : u ≤ a := (le_max_left _ _).trans (le_max_right _ _)
      have hav : v ≤ a := (le_max_right _ _).trans (le_max_right _ _)
      have hfa : f a < 0 := by
        rcases hmax l (max u v) with he | he
        · exact hn ha (Or.inl he)
        · rcases hmax u v with he' | he'
          · exact hn ha (Or.inr (Or.inr (Or.inl (he.trans he'))))
          · exact hn ha (Or.inr (Or.inr (Or.inr (he.trans he'))))
      exact (h11.le_max_of_mem_Icc ⟨⟨ha, hau⟩, hav⟩
        ⟨⟨⟨hlr, le_rfl⟩, (le_of_not_ge hxu).trans hx.2⟩,
          (le_of_not_ge hxv).trans hx.2⟩ ⟨hax, hx.2⟩).trans_lt (max_lt hfa hr)


