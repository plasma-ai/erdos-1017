private theorem paid_pole {b z eta q : ℝ}
    (hb : b ∈ Icc bZero (1 / 4)) (hz : z ∈ Icc 0 b)
    (heta : lowerEta b z ≤ eta) (hq : 0 ≤ q) (hbudget : q ≤ moment b z eta) :
