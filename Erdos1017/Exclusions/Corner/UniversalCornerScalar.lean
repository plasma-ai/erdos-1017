      chart_positive (P := lowerP) (cap := fun b => b) eta_lo_low_P_chart hlt hmem hbpos hz,
      chart_positive (P := lowerS) (cap := fun b => b) eta_lo_low_S_chart hlt hmem hbpos hz⟩
  · have hmem : b ∈ Icc (2 / 15) (1 / 4) := ⟨le_of_not_ge hlow, hb.2⟩
    have hden : 0 < lowerDenominator b := by
