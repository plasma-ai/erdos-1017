      reciprocal (A - z) (1 - 2 * A - b) (1 - A - b - u) q ≤
      (b * ell - gammaZero ell) * I0 :=
    (mul_le_mul_of_nonneg_left hrecip hprice.le).trans
      (mul_le_mul_of_nonneg_right (by linarith [hgamma]) hIpos)
  have hR : min (1 - 3 * A + b) ((1 - u - 2 * ell * A - 3 * gamma) / ell) ≤
