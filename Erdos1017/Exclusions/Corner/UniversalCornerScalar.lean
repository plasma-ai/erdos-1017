private def lowerEta (b z : ℝ) : ℝ := tZero - b + ellLower * z
private def lowerQ (b z : ℝ) : ℝ :=
  hUpper - a ^ 2 + b ^ 2 - 2 * tZero * b - 2 * ellLower * b * z - z ^ 2
private def lowerTarget (b z : ℝ) : ℝ :=
  a - b + 2 * bZero / 5 - (7 / 18 + ellLower / (2 * ellUpper ^ 2)) * z
private def lowerD (b z : ℝ) : ℝ :=
  lowerTarget b z * (a - z) - (b - bZero) * lowerEta b z
private def lowerP (b z : ℝ) : ℝ := (a - z) * lowerD b z - (b - bZero) * lowerQ b z
private def lowerS (b z : ℝ) : ℝ := (lowerP b z) ^ 2 - (lowerD b z) ^ 2 * lowerQ b z
private def lowerNumerator (b : ℝ) : ℝ :=
  hUpper - a ^ 2 + b ^ 2 - 2 * tZero * b + 1 / 64
private def lowerDenominator (b : ℝ) : ℝ := 2 * (1 / 8 + ellLower * b)

private def capEta (b : ℝ) : ℝ := tZero - 2 * b / 11
private def capQ (b z : ℝ) : ℝ := hUpper - a ^ 2 - 2 * tZero * b - 7 * b ^ 2 / 11 - z ^ 2
private def capTarget (b z : ℝ) : ℝ := a + 2 * bZero / 5 - 29 * b / 18 - 7 * z / 18
private def capM (b z : ℝ) : ℝ := capTarget b z * (a - z) - (b - bZero) * capEta b
private def capP (b z : ℝ) : ℝ := (a - z) * capM b z - (b - bZero) * capQ b z
private def capS (b z : ℝ) : ℝ := (capP b z) ^ 2 - (capM b z) ^ 2 * capQ b z
private def capZ (b : ℝ) : ℝ := 4 * (hUpper - a ^ 2 - 2 * tZero * b - 7 * b ^ 2 / 11) + 1 / 16

private def zeroConstant (b z : ℝ) : ℝ :=
  2 * b * capTarget b z * (a - z) - (b - bZero) * (hUpper - a ^ 2 - b ^ 2 - z ^ 2)
private def zeroMoving (b z : ℝ) : ℝ :=
  2 * b * (a - z) * (a - b + 2 * bZero / 5 - 7 * z / 18 - (121 / 162) * (b - tZero)) -
    (hUpper - a ^ 2 - b ^ 2 - z ^ 2) * (b - bZero + (121 / 162) * (a - z))

