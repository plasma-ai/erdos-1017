private theorem reduced_negative {b z eta : ℝ} (hb : b ∈ Icc bZero (1 / 4))
    (hz : z ∈ Icc 0 b) (heta : lowerEta b z ≤ eta)
    (hu : eta ≤ 2 * a - b - z) (hQ : 0 ≤ moment b z eta) : reduced b z eta < 0 := by
  let l := lowerEta b z
  let r := min (2 * a - b - z) ((hUpper - a ^ 2 - b ^ 2 - z ^ 2) / (2 * b))
  have hbpos : 0 < b := lt_of_lt_of_le (by norm_num [bZero]) hb.1
  have hupper : eta ≤ (hUpper - a ^ 2 - b ^ 2 - z ^ 2) / (2 * b) := by
    apply (le_div_iff₀ (show 0 < 2 * b by positivity)).mpr
    dsimp [moment] at hQ
    linarith
  have hmem : eta ∈ Icc l r := ⟨heta, le_min hu hupper⟩
  have hlr : l ≤ r := hmem.1.trans hmem.2
  have hdom : ∀ t ∈ Icc l r, lowerEta b z ≤ t ∧ 0 ≤ moment b z t := by
    intro t ht
    refine ⟨ht.1, ?_⟩
    have hright := ht.2.trans (min_le_right _ _)
    have hmul := (le_div_iff₀ (show 0 < 2 * b by positivity)).mp hright
    dsimp [moment]
    linarith
  have h00 : ConvexOn ℝ (Icc l r ∩ Iic (capEta b) ∩ Iic (sourceEta b z)) (reduced b z) := by
    apply reduced_convex_cell (((convex_Icc l r).inter (convex_Iic _)).inter (convex_Iic _)) hb hz
    · intro t ht
      exact hdom t ht.1.1
    · exact cap_affine_left (fun t ht => ht.1.2)
    · exact Or.inl (fun t ht => ht.2)
  have h01 : ConvexOn ℝ (Icc l r ∩ Iic (capEta b) ∩ Ici (sourceEta b z)) (reduced b z) := by
    apply reduced_convex_cell (((convex_Icc l r).inter (convex_Iic _)).inter (convex_Ici _)) hb hz
    · intro t ht
      exact hdom t ht.1.1
    · exact cap_affine_left (fun t ht => ht.1.2)
    · exact Or.inr (fun t ht => ht.2)
  have h10 : ConvexOn ℝ (Icc l r ∩ Ici (capEta b) ∩ Iic (sourceEta b z)) (reduced b z) := by
    apply reduced_convex_cell (((convex_Icc l r).inter (convex_Ici _)).inter (convex_Iic _)) hb hz
    · intro t ht
      exact hdom t ht.1.1
    · exact cap_affine_right (fun t ht => ht.1.2)
    · exact Or.inl (fun t ht => ht.2)
  have h11 : ConvexOn ℝ (Icc l r ∩ Ici (capEta b) ∩ Ici (sourceEta b z)) (reduced b z) := by
    apply reduced_convex_cell (((convex_Icc l r).inter (convex_Ici _)).inter (convex_Ici _)) hb hz
    · intro t ht
      exact hdom t ht.1.1
    · exact cap_affine_right (fun t ht => ht.1.2)
    · exact Or.inr (fun t ht => ht.2)
  apply negative_with_two_cuts h00 h01 h10 h11
  · exact lower_boundary hb hz (hdom l ⟨le_rfl, hlr⟩).2
  · rcases le_total (2 * a - b - z) ((hUpper - a ^ 2 - b ^ 2 - z ^ 2) / (2 * b)) with h | h
    · have heq : r = 2 * a - b - z := min_eq_left h
      rw [heq]
      apply mass_boundary hb hz
      rw [← heq]
      exact (hdom r ⟨hlr, le_rfl⟩).2
    · have heq : r = (hUpper - a ^ 2 - b ^ 2 - z ^ 2) / (2 * b) := min_eq_right h
      rw [heq]
      exact zero_boundary hb hz
  · intro ht
    exact cap_boundary hb hz (hdom (capEta b) ht).2
  · intro ht
    exact source_boundary hb hz ht.1
  · exact hmem

/-- The correlated positive-price state is impossible at the literal corner bounds. -/
theorem positive_price_false {A b u h ell c z q : ℝ}
    (hA : A ∈ Ioo (1 / 3 : ℝ) (369 / 1000))
    (hell : ell ∈ Icc (363 / 589 : ℝ) (9 / 11))
    (hh : h < (23243417 / 10 ^ 8 : ℝ))
    (hc : (138261458236451 / 1116960975000000 : ℝ) < c)
    (hb : 0 < b) (hbcap : b ≤ 1 - 2 * A) (hu : u ∈ Ico 0 (1 - 2 * A))
    (hz : z ∈ Icc 0 (min (1 - 3 * A + b)
      ((1 - u - 2 * ell * A - 3 * (2 * c - ell * h)) / ell)))
    (hzu : z ≤ u) (hq : 0 ≤ q)
    (hholes : q + z ^ 2 ≤ h - A ^ 2 - b ^ 2 - 2 * b * (1 - A - b - u))
    (hprice : 0 < b * ell - (2 * c - ell * h))
    (hF :
      let gamma := 2 * c - ell * h
      let eta := 1 - A - b - u
      let C := 1 - 2 * A - b
      let Rcap := min (1 - 3 * A + b) ((1 - u - 2 * ell * A - 3 * gamma) / ell)
      let k := A - z
      let alpha := min C (Real.sqrt q)
      0 < (b * ell - gamma) * (eta / k + q / (k * (k - alpha))) +
        (ell - 1 / 2) * z + Rcap / 2 - ell * (A - b) - 2 * gamma / 5) : False := by
  have hA' : a < A := hA.1
  have hell' : ell ∈ Icc ellLower ellUpper := hell
  have hellpos : 0 < ell := lt_of_lt_of_le (by norm_num) hell.1
  have hgamma : gammaZero ell < 2 * c - ell * h := by
    have hprod := mul_pos hellpos (sub_pos.mpr hh)
    dsimp [gammaZero, gConst, hUpper]
    nlinarith only [hc, hprod]
  obtain ⟨hbmem, hzmem, heta, hetau, hQ⟩ :=
    relaxed_domain hA' hell' hh.le hgamma hb hbcap hz hzu hq hholes hprice
  have hrelax := price_le_reduced hA' hell' hh.le hgamma hb hbcap hu hz hzu hq hholes hprice
  have hnegative := reduced_negative hbmem hzmem heta hetau (hq.trans hQ)
  have hEpos : 0 < ellUpper := by norm_num [ellUpper]
  have hbound : priceState A b u ell (2 * c - ell * h) z q < 0 :=
    hrelax.trans_lt (mul_neg_of_pos_of_neg hEpos hnegative)
  change 0 < priceState A b u ell (2 * c - ell * h) z q at hF
  exact (lt_irrefl _ (hF.trans hbound))

