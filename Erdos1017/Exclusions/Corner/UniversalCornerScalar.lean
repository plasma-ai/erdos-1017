/-!
# Scalar price exclusion at the corner

The corner scalar licenses the error, the zero price and one joint hole-deficit
inventory with all signs derived, and both the nonpositive price, including
equality, and the correlated positive-price state are impossible at the corner
bounds.
-/

@[expose] public section

noncomputable section

open Set
open scoped BigOperators unitInterval

namespace Erdos1017.UniversalCornerScalar

private def a : ℝ := 1 / 3
private def hUpper : ℝ := 23243417 / 10 ^ 8
private def gConst : ℝ := 2 * (138261458236451 / 1116960975000000)
private def ellLower : ℝ := 363 / 589
private def ellUpper : ℝ := 9 / 11
private def tZero : ℝ := 572334702503011 / 1489281300000000
private def bZero : ℝ := 2820692027533121 / 40210595100000000

private def gammaZero (ell : ℝ) : ℝ := gConst - ell * hUpper
private def rowZero (A ell : ℝ) : ℝ := ell + gammaZero ell - (1 + ell) * A
private def radZero (A ell : ℝ) : ℝ := (2 * ell - 1) * A + 3 * gammaZero ell
private def defectZero (A ell : ℝ) : ℝ := 2 * ell * (1 - 2 * A) - rowZero A ell

private def errorThreeFifths (A ell : ℝ) : ℝ :=
  (12 / 5) * gammaZero ell * rowZero A ell * radZero A ell -
    (A - 3 * gammaZero ell) * (defectZero A ell) ^ 2

private def errorOneTwentyfifth (A ell : ℝ) : ℝ :=
  (4 / 25) * rowZero A ell * radZero A ell -
    (A - 3 * gammaZero ell) * (defectZero A ell) ^ 2

private def zeroPrice (A ell : ℝ) : ℝ :=
  2 * ell ^ 2 * A * gammaZero ell -
    ((3 - 2 * ell) * A - 6 * gammaZero ell) *
      (ell + A * (1 + ell - 4 * ell ^ 2) - gammaZero ell * (1 + 6 * ell))

private def momentG0 (A ell : ℝ) : ℝ :=
  (3 * gammaZero ell - A * (1 - ell)) * (18 * A - 22 * A ^ 2 - 3 - hUpper) -
    2 * A * (2 - 4 * A) * (1 - ell - 2 * gammaZero ell)

private def momentG1 (A ell : ℝ) : ℝ :=
  (3 * gammaZero ell - A * (1 - ell)) * (2 - 8 * A) +
    2 * A * ((2 - 4 * A) * (1 - ell) + 1 - ell - 2 * gammaZero ell)

private def momentG2 (A ell : ℝ) : ℝ := -2 * A * (1 - ell)

private def momentLower (A ell : ℝ) : ℝ :=
  4 * ell ^ 2 * momentG0 A ell + 2 * ell * rowZero A ell * momentG1 A ell +
    (rowZero A ell) ^ 2 * momentG2 A ell

private def momentUpper (A ell : ℝ) : ℝ :=
  momentG0 A ell + (1 - 2 * A) * momentG1 A ell +
    (1 - 2 * A) ^ 2 * momentG2 A ell

private theorem tensor_bernstein_lower (n m : ℕ)
    (c : Fin (n + 1) → Fin (m + 1) → ℝ) (b : ℝ)
    (hc : ∀ i j, b ≤ c i j) (u v : I) :
    b ≤ ∑ i, ∑ j, c i j * bernstein n i u * bernstein m j v := by
  have hsum : (∑ i : Fin (n + 1), ∑ j : Fin (m + 1),
      b * bernstein n i u * bernstein m j v) ≤
      ∑ i : Fin (n + 1), ∑ j : Fin (m + 1), c i j * bernstein n i u * bernstein m j v :=
    Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun j _ =>
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (hc i j) bernstein_nonneg)
        bernstein_nonneg))
  simp only [← Finset.mul_sum, bernstein.probability, mul_one] at hsum
  exact hsum

