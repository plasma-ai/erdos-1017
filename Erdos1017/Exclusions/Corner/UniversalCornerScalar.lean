    apply reciprocal_le hk (by linarith) hCLE heta0 hetaLE hq hQ
    linarith
  have hetapos : 0 ≤ eta := by
    have ht : (1 / 4 : ℝ) < tZero := by norm_num [tZero]
    have hLz : 0 ≤ ellLower * z := mul_nonneg (by norm_num [ellLower]) hzmem.1
    dsimp [lowerEta] at heta
    dsimp [eta]
    linarith [hbmem.2]
