  have hminC := min_le_left (a - b) (Real.sqrt q)
  have hminRoot := min_le_right (a - b) (Real.sqrt q)
  have hzlo : b - 1 / 200 ≤ z := by linarith
  have hrootlo : a - b - 1 / 200 ≤ Real.sqrt q := by linarith [hz.2]
  have hCpos : 0 < a - b - 1 / 200 := by
    norm_num [a]
    linarith [hb.2]
  have hqlo : (a - b - 1 / 200) ^ 2 ≤ q := by
    nlinarith [Real.sq_sqrt hq, Real.sqrt_nonneg q,
      mul_nonneg (sub_nonneg.mpr hrootlo)
        (show 0 ≤ Real.sqrt q + (a - b - 1 / 200) by positivity)]
  have hzsq : (b - 1 / 200) ^ 2 ≤ z ^ 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hzlo)
      (show 0 ≤ z + (b - 1 / 200) by linarith [hz.1])]
  have hL : 0 < ellLower := by norm_num [ellLower]
  have hetalo : tZero - b + ellLower * (b - 1 / 200) ≤ eta := by
    dsimp [lowerEta] at heta
    nlinarith [mul_nonneg hL.le (sub_nonneg.mpr hzlo)]
  have hetaprod := mul_nonneg (show 0 ≤ 2 * b by positivity)
    (sub_nonneg.mpr hetalo)
  let pole (b : ℝ) := 2 * a ^ 2 - 2 * a / 200 + 2 / 200 ^ 2 +
    (1 + 2 * ellLower) * b ^ 2 + 2 * b * (tZero - a - ellLower / 200) - hUpper
  have hbase : 0 < pole bZero := by norm_num [pole, a, ellLower, tZero, hUpper, bZero]
  have hdiff : 0 ≤ (b - bZero) *
      ((1 + 2 * ellLower) * (b + bZero) + 2 * (tZero - a - ellLower / 200)) := by
    apply mul_nonneg (sub_nonneg.mpr hb.1)
    have hconst : 0 < tZero - a - ellLower / 200 := by
      norm_num [tZero, a, ellLower]
    have hbZero : 0 < bZero := by norm_num [bZero]
