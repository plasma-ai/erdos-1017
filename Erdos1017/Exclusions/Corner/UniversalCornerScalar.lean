  nlinarith

private def reciprocal (k C eta q : ℝ) : ℝ :=
  eta / k + q / (k * (k - min C (Real.sqrt q)))

set_option maxHeartbeats 2000000 in
private theorem reciprocal_le {k k' C C' eta eta' q Q : ℝ}
    (hk' : 0 < k') (hk : k' ≤ k) (hC : C ≤ C')
    (heta : 0 ≤ eta) (heta' : eta ≤ eta') (hq : 0 ≤ q) (hQ : q ≤ Q)
    (hpole : 0 < k' - min C' (Real.sqrt Q)) :
    reciprocal k C eta q ≤ reciprocal k' C' eta' Q := by
  have hkpos : 0 < k := lt_of_lt_of_le hk' hk
  have halpha : min C (Real.sqrt q) ≤ min C' (Real.sqrt Q) :=
    min_le_min hC (Real.sqrt_le_sqrt hQ)
  have hgap : k' - min C' (Real.sqrt Q) ≤ k - min C (Real.sqrt q) := by linarith
  have hden : k' * (k' - min C' (Real.sqrt Q)) ≤
      k * (k - min C (Real.sqrt q)) :=
    mul_le_mul hk hgap hpole.le hkpos.le
  have hfirst : eta / k ≤ eta' / k' :=
    (div_le_div_of_nonneg_left heta hk' hk).trans
      (div_le_div_of_nonneg_right heta' hk'.le)
  have hsecond : q / (k * (k - min C (Real.sqrt q))) ≤
      Q / (k' * (k' - min C' (Real.sqrt Q))) :=
    (div_le_div_of_nonneg_left hq (mul_pos hk' hpole) hden).trans
      (div_le_div_of_nonneg_right hQ (mul_nonneg hk'.le hpole.le))
  exact add_le_add hfirst hsecond

