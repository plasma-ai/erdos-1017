  have hellpos : 0 < ell := lt_of_lt_of_le (by norm_num [ellLower]) hell.1
  have heta0 : 0 ≤ 1 - A - b - u := by
    norm_num [a] at hA
    linarith [hu.2]
  have hetaLE : 1 - A - b - u ≤ eta := by
    dsimp [eta, a]
    norm_num [a] at hA
    linarith
  have hCLE : 1 - 2 * A - b ≤ a - b := by
    norm_num [a] at hA ⊢
    linarith
