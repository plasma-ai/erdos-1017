private theorem price_le_reduced {A b u h ell gamma z q : ℝ}
    (hA : a < A) (hell : ell ∈ Icc ellLower ellUpper)
    (hh : h ≤ hUpper) (hgamma : gammaZero ell < gamma)
    (hb : 0 < b) (hbcap : b ≤ 1 - 2 * A) (hu : u ∈ Ico 0 (1 - 2 * A))
    (hz : z ∈ Icc 0 (min (1 - 3 * A + b) ((1 - u - 2 * ell * A - 3 * gamma) / ell)))
    (hzu : z ≤ u) (hq : 0 ≤ q)
    (hholes : q + z ^ 2 ≤ h - A ^ 2 - b ^ 2 - 2 * b * (1 - A - b - u))
    (hprice : 0 < b * ell - gamma) :
    priceState A b u ell gamma z q ≤ ellUpper * reduced b z (2 * a - b - u) := by
  obtain ⟨hbmem, hzmem, heta, hetau, hQ⟩ :=
    relaxed_domain hA hell hh hgamma hb hbcap hz hzu hq hholes hprice
  let eta := 2 * a - b - u
