private theorem cap_affine_left {D : Set ℝ} {b : ℝ}
    (hD : ∀ eta ∈ D, eta ≤ capEta b) :
    ∃ r0 r1 : ℝ, ∀ eta ∈ D,
      min b ((eta + b - tZero) / ellUpper) = r0 + r1 * eta := by
  refine ⟨(b - tZero) / ellUpper, 1 / ellUpper, ?_⟩
  intro eta heta
  have hle : (eta + b - tZero) / ellUpper ≤ b := by
    have h := hD eta heta
    dsimp [capEta] at h
    norm_num [ellUpper]
    linarith
  rw [min_eq_right hle]
  ring

set_option maxHeartbeats 2000000 in
private theorem cap_affine_right {D : Set ℝ} {b : ℝ}
    (hD : ∀ eta ∈ D, capEta b ≤ eta) :
    ∃ r0 r1 : ℝ, ∀ eta ∈ D,
      min b ((eta + b - tZero) / ellUpper) = r0 + r1 * eta := by
  refine ⟨b, 0, ?_⟩
  intro eta heta
  have hle : b ≤ (eta + b - tZero) / ellUpper := by
    have h := hD eta heta
    dsimp [capEta] at h
    norm_num [ellUpper]
    linarith
  rw [min_eq_left hle]
  ring

