    have hzcap : z ∈ Icc 0 (lowerNumerator b / lowerDenominator b) := ⟨hz.1, hcap⟩
    have hcapPos : 0 < lowerNumerator b / lowerDenominator b := div_pos hN hden
    exact ⟨chart_positive (P := lowerD) (cap := fun b => lowerNumerator b / lowerDenominator b)
        eta_lo_high_D_chart (by norm_num) hmem hcapPos hzcap,
