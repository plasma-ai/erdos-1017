private theorem min_cap_loss {ell E b K t : ℝ}
    (hell : 0 < ell) (hE : ell ≤ E) (hb : K ≤ b) :
    min b (K + t / ell) - min b (K + t / E) ≤ (E - ell) * (b - K) / E := by
  have hEpos : 0 < E := lt_of_lt_of_le hell hE
  apply (le_div_iff₀ hEpos).mpr
  by_cases hconstant : b ≤ K + t / E
  · rw [min_eq_left hconstant]
    have hleft := mul_nonpos_of_nonpos_of_nonneg
      (sub_nonpos.mpr (min_le_left b (K + t / ell))) hEpos.le
    have hright := mul_nonneg (sub_nonneg.mpr hE) (sub_nonneg.mpr hb)
    linarith
  · rw [min_eq_right (le_of_not_ge hconstant)]
    have hfirst := mul_nonneg (sub_nonneg.mpr hE)
      (sub_nonneg.mpr (min_le_left b (K + t / ell)))
    have hsecond := (le_div_iff₀ hell).mp
      (show min b (K + t / ell) - K ≤ t / ell by linarith [min_le_right b (K + t / ell)])
    have hid : (min b (K + t / ell) - (K + t / E)) * E =
        (E - ell) * min b (K + t / ell) +
          (min b (K + t / ell) - K) * ell - (E - ell) * K - t := by
      field_simp
      ring
    rw [hid]
    nlinarith only [hfirst, hsecond]

