private theorem ell_shift {b z u ell I0 : ℝ}
    (hb : b ∈ Icc bZero (1 / 4)) (hz : 0 ≤ z)
    (hell : ell ∈ Icc ellLower ellUpper) (hI : 3 * (tZero - b) ≤ I0) :
    (b * ell - gammaZero ell) * I0 + (ell - 1 / 2) * z +
        min b ((1 - u - 2 * ell * a - 3 * gammaZero ell) / ell) / 2 -
          ell * (a - b) - 2 * gammaZero ell / 5 ≤
    (b * ellUpper - gammaZero ellUpper) * I0 + (ellUpper - 1 / 2) * z +
        min b ((1 - u - 2 * ellUpper * a - 3 * gammaZero ellUpper) / ellUpper) / 2 -
          ellUpper * (a - b) - 2 * gammaZero ellUpper / 5 := by
  let K := 3 * hUpper - 2 * a
  let t := 1 - u - 3 * gConst
  have hellpos : 0 < ell := lt_of_lt_of_le (by norm_num [ellLower]) hell.1
  have hEpos : 0 < ellUpper := by norm_num [ellUpper]
  have hLpos : 0 < ellLower := by norm_num [ellLower]
  have hbK : K ≤ b := by
    have hfixed : K < bZero := by norm_num [K, hUpper, a, bZero]
    linarith [hb.1]
  have hcap := min_cap_loss (t := t) hellpos hell.2 hbK
  have hloss : (ellUpper - ell) * (b - K) / ellUpper ≤
      (ellUpper - ell) * (b - K) / ellLower :=
    div_le_div_of_nonneg_left
      (mul_nonneg (sub_nonneg.mpr hell.2) (sub_nonneg.mpr hbK)) hLpos
      (by norm_num [ellLower, ellUpper])
  have hleftId : (1 - u - 2 * ell * a - 3 * gammaZero ell) / ell = K + t / ell := by
    dsimp [K, t, gammaZero]
    field_simp
    ring
  have hrightId : (1 - u - 2 * ellUpper * a - 3 * gammaZero ellUpper) / ellUpper =
      K + t / ellUpper := by
    dsimp [K, t, gammaZero]
    field_simp
    ring
  let slope (b : ℝ) := 3 * (b + hUpper) * (tZero - b) + b - a + 2 * hUpper / 5 -
    (b - K) / (2 * ellLower)
  have hslope : 0 < slope b := by
    have hpoly := quadratic_positive (by norm_num [bZero]) hb (by norm_num : (-3 : ℝ) ≤ 0)
      (c0 := 3 * hUpper * tZero - a + 2 * hUpper / 5 + K / (2 * ellLower))
      (c1 := 3 * (tZero - hUpper) + 1 - 1 / (2 * ellLower))
      (by norm_num [K, a, hUpper, tZero, ellLower, bZero])
      (by norm_num [K, a, hUpper, tZero, ellLower])
    convert hpoly using 1
    dsimp [slope]
    ring
  have hbpos : 0 < b := lt_of_lt_of_le (by norm_num [bZero]) hb.1
  have hHpos : 0 < hUpper := by norm_num [hUpper]
  have hIprod := mul_nonneg (show 0 ≤ b + hUpper by positivity) (sub_nonneg.mpr hI)
  have hslopeProd := mul_nonneg (sub_nonneg.mpr hell.2) hslope.le
  have hwhole : 0 ≤ (ellUpper - ell) *
      ((b + hUpper) * I0 + z + b - a + 2 * hUpper / 5 -
        (b - K) / (2 * ellLower)) := by
    apply mul_nonneg (sub_nonneg.mpr hell.2)
    dsimp [slope] at hslope
    linarith
  rw [hleftId, hrightId]
  have hcap' := hcap.trans hloss
  have hid : (ellUpper - ell) *
      ((b + hUpper) * I0 + z + b - a + 2 * hUpper / 5) =
      (ellUpper * b - gammaZero ellUpper) * I0 + (ellUpper - 1 / 2) * z -
        ellUpper * (a - b) - 2 * gammaZero ellUpper / 5 -
      ((ell * b - gammaZero ell) * I0 + (ell - 1 / 2) * z -
        ell * (a - b) - 2 * gammaZero ell / 5) := by
    dsimp [gammaZero]
    ring
  dsimp [gammaZero] at *
  dsimp only [ellLower] at hwhole hcap'
  ring_nf at hwhole hcap' hid ⊢
  linarith only [hwhole, hcap', hid]

private def priceState (A b u ell gamma z q : ℝ) : ℝ :=
  (b * ell - gamma) * reciprocal (A - z) (1 - 2 * A - b) (1 - A - b - u) q +
  (ell - 1 / 2) * z + min (1 - 3 * A + b) ((1 - u - 2 * ell * A - 3 * gamma) / ell) / 2 -
  ell * (A - b) - 2 * gamma / 5

