private theorem reciprocal_ratio {Q Q0 C C0 r : ℝ}
    (hQ : 0 ≤ Q) (hQ0 : 0 < Q0) (hC : 0 < C) (hC0 : 0 < C0)
    (hr : 0 ≤ r) (hpole : r < C0)
