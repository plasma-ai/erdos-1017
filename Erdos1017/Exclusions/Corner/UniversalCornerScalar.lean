        eta_lo_high_S_chart (by norm_num) hmem hcapPos hzcap⟩

set_option maxHeartbeats 2000000 in
private theorem lower_boundary {b z : ℝ} (hb : b ∈ Icc bZero (1 / 4))
    (hz : z ∈ Icc 0 b) (hQ : 0 ≤ moment b z (lowerEta b z)) :
    reduced b z (lowerEta b z) < 0 := by
  have hQeq : moment b z (lowerEta b z) = lowerQ b z := by
    dsimp [moment, lowerEta, lowerQ]
    ring
  rw [hQeq] at hQ
  obtain ⟨hD, hP, hS⟩ := lower_chart_signs hb hz hQ
  have hk : 0 < a - z := by
    norm_num [a]
    linarith [hz.2, hb.2]
  have hraw := square_sign_bound (C := a - b) hk (sub_nonneg.mpr hb.1) hQ hD hP hS
  have hR : min b ((lowerEta b z + b - tZero) / ellUpper) =
      ellLower / ellUpper * z := by
    have hle : ellLower / ellUpper * z ≤ b := by
      norm_num [ellLower, ellUpper]
      linarith [hz.1, hz.2]
    have hid : (lowerEta b z + b - tZero) / ellUpper =
        ellLower / ellUpper * z := by
      dsimp [lowerEta]
      ring
    rw [hid, min_eq_right hle]
  have hid : reduced b z (lowerEta b z) =
      (b - bZero) * (lowerEta b z / (a - z) + lowerQ b z /
        ((a - z) * (a - z - min (a - b) (Real.sqrt (lowerQ b z))))) -
      lowerTarget b z := by
    dsimp only [reduced]
    rw [hR, hQeq]
    norm_num [lowerTarget, ellLower, ellUpper]
    ring
  rw [hid]
  exact sub_neg.mpr hraw

set_option maxHeartbeats 2000000 in
private theorem cap_chart_signs {b z : ℝ} (hb : b ∈ Icc bZero (1 / 4))
