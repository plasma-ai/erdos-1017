    exact hi_boundary_signs ⟨by linarith, hb.2⟩ hz.1 hcap


/-- Moment cap on the enlarged upper-E2 scalar domain. -/
def enlargedQ (b z eta : ℝ) : ℝ :=
  3509 / 14884 - (1 / 3 : ℝ) ^ 2 - b ^ 2 - z ^ 2 - 2 * b * eta

theorem enlarged_pole_pos {b z eta : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (heta : 1547 / 4026 - b + (4 / 5 : ℝ) * z ≤ eta)
    (hq : 0 ≤ enlargedQ b z eta) :
    1 / 200 < (1 / 3 - z) -
      min (1 / 3 - b) (Real.sqrt (enlargedQ b z eta)) := by
  by_contra! hbad
  have hbpos : 0 < b := by linarith [hb.1]
  have hsqrt : 0 ≤ Real.sqrt (enlargedQ b z eta) := Real.sqrt_nonneg _
  have hsq : (Real.sqrt (enlargedQ b z eta)) ^ 2 = enlargedQ b z eta :=
    Real.sq_sqrt hq
  have hminC : min (1 / 3 - b) (Real.sqrt (enlargedQ b z eta)) ≤
      1 / 3 - b := min_le_left _ _
  have hminS : min (1 / 3 - b) (Real.sqrt (enlargedQ b z eta)) ≤
      Real.sqrt (enlargedQ b z eta) := min_le_right _ _
  have hzb : b - 1 / 200 ≤ z := by linarith
  have hsqrtbound : 1 / 3 - b - 1 / 200 ≤
      Real.sqrt (enlargedQ b z eta) := by linarith [hz.2]
  have hqlo : (1 / 3 - b - 1 / 200) ^ 2 ≤ enlargedQ b z eta := by
    have hpositive : 0 ≤ 1 / 3 - b - 1 / 200 := by linarith [hb.2]
    nlinarith [hsq]
  have hnum : 3509 / 14884 <
      2 * (1 / 3 : ℝ) ^ 2 - 2 * (1 / 3) * (1 / 200) +
      2 * (1 / 200) ^ 2 + (1 + 2 * (4 / 5)) * b ^ 2 +
      2 * b * (1547 / 4026 - 1 / 3 - (4 / 5) * (1 / 200)) := by
    have hmon : 0 ≤ (b - 77 / 1098) *
        ((1 + 2 * (4 / 5 : ℝ)) * (b + 77 / 1098) +
          2 * (1547 / 4026 - 1 / 3 - (4 / 5) * (1 / 200))) := by
      apply mul_nonneg (by linarith [hb.1])
      nlinarith [hb.1]
    nlinarith [hmon]
  unfold enlargedQ at hqlo
  nlinarith [sq_nonneg (z - (b - 1 / 200)),
    mul_nonneg (by linarith [hbpos] : 0 ≤ b) (by linarith [heta] : 0 ≤ eta - (1547 / 4026 - b + (4 / 5 : ℝ) * z))]


/-- The enlarged signed-price expression after the exact physical reductions. -/
def enlargedF (b z eta : ℝ) : ℝ :=
  let k := 1 / 3 - z
  let C0 := 1 / 3 - b
  let Q := enlargedQ b z eta
  let R := min b ((eta + b - 1547 / 4026) / (9 / 11))
  (b - 77 / 1098) *
      (eta / k + Q / (k * (k - min C0 (Real.sqrt Q)))) +
    7 * z / 18 + 11 * R / 18 - (1 / 3 - b) - 2 * (77 / 1098) / 5

private theorem radical_min_le {k q alpha : ℝ}
    (hk : 0 < k) (hq : 0 ≤ q)
    (ha : alpha ≤ Real.sqrt q) (hks : Real.sqrt q < k) :
    q / (k * (k - alpha)) ≤
      q / (k * (k - Real.sqrt q)) := by
  have ha0 : 0 < k * (k - alpha) :=
    mul_pos hk (sub_pos.mpr (lt_of_le_of_lt ha hks))
  have hs0 : 0 < k * (k - Real.sqrt q) :=
    mul_pos hk (sub_pos.mpr hks)
  apply (div_le_div_iff₀ ha0 hs0).mpr
  nlinarith [mul_nonneg hq (sub_nonneg.mpr ha)]

private theorem radical_boundary_formula_neg
    {k q D P rb eta target alpha : ℝ}
    (hk : 0 < k) (hq : 0 ≤ q) (hks : Real.sqrt q < k)
    (hP : 0 < P) (hS : 0 < P ^ 2 - D ^ 2 * q)
    (hPeq : P = k * D - rb * q)
    (hDeq : D = target * k - rb * eta)
    (hrb : 0 ≤ rb) (ha : alpha ≤ Real.sqrt q) :
    rb * (eta / k + q / (k * (k - alpha))) < target := by
  have hmin := radical_min_le hk hq ha hks
  have hbase := radical_boundary_algebra hk hq hks hP hS hPeq hDeq
  have hmul := mul_le_mul_of_nonneg_left hmin hrb
  nlinarith


private theorem enlargedF_etaLo_neg {b z : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (hq : 0 ≤ loQ b z)
    (hpole : Real.sqrt (loQ b z) < 1 / 3 - z) :
    enlargedF b z (1547 / 4026 - b + (4 / 5 : ℝ) * z) < 0 := by
  have hsigns := lo_boundary_signs_of_feasible hb hz hq
  have hk : 0 < 1 / 3 - z := by
    linarith [hz.2, hb.2]
  have hrb : 0 ≤ b - 77 / 1098 := by linarith [hb.1]
  have hqeq : enlargedQ b z (1547 / 4026 - b + (4 / 5 : ℝ) * z) =
      loQ b z := by
    unfold enlargedQ loQ
    ring_nf
  have hR : min b (((1547 / 4026 - b + (4 / 5 : ℝ) * z) + b -
        1547 / 4026) / (9 / 11)) = (4 / 5 : ℝ) * z / (9 / 11) := by
    have hle : (4 / 5 : ℝ) * z / (9 / 11) ≤ b := by
      have : (4 / 5 : ℝ) * z / (9 / 11) = 44 / 45 * z := by ring
      rw [this]
      nlinarith [hz.1, hz.2]
    rw [min_eq_right]
    · ring
    · convert hle using 1; ring
  have hbound := radical_boundary_formula_neg
    (alpha := min (1 / 3 - b) (Real.sqrt (loQ b z)))
    hk hq hpole hsigns.2.1
    hsigns.2.2 (show loP b z = (1 / 3 - z) * loD b z -
      (b - 77 / 1098) * loQ b z from rfl)
    (show loD b z =
      ((1 / 3 - b + 2 * (77 / 1098 : ℝ) / 5) -
        (7 / 18 + (4 / 5 : ℝ) / (2 * (9 / 11 : ℝ) ^ 2)) * z) *
          (1 / 3 - z) -
        (b - 77 / 1098) * (1547 / 4026 - b + (4 / 5 : ℝ) * z) from rfl)
    hrb (min_le_right _ _)
  unfold enlargedF
  rw [hqeq, hR]
  dsimp only
  nlinarith [hbound]

private theorem hi_u_neg_of_box {b z lo hi root qmax : ℝ}
    (hlo : 77 / 1098 ≤ lo) (hb : b ∈ Icc lo hi)
    (hz : z ∈ Icc (0 : ℝ) b)
    (hq : 0 ≤ enlargedQ b z (2 / 3 - b - z))
    (hqmax : enlargedQ b z (2 / 3 - b - z) ≤ qmax)
    (hroot : Real.sqrt (enlargedQ b z (2 / 3 - b - z)) ≤ root)
    (hrootpos : 0 < root) (hC : root < 1 / 3 - hi)
    (hmargin : (hi - 77 / 1098) *
        (2 + qmax / ((1 / 3 - hi) * (1 / 3 - hi - root))) +
      2 * hi - 1 / 3 - 2 * (77 / 1098) / 5 < 0) :
    enlargedF b z (2 / 3 - b - z) < 0 := by
  let Q := enlargedQ b z (2 / 3 - b - z)
  let k := 1 / 3 - z
  let C0 := 1 / 3 - b
  let alpha := min C0 (Real.sqrt Q)
  let Dmin := (1 / 3 - hi) * (1 / 3 - hi - root)
  let D := k * (k - alpha)
  have hCmin : 0 < 1 / 3 - hi := by linarith [hC]
  have hDmin : 0 < Dmin := mul_pos hCmin (by linarith [hC])
  have hkc : 1 / 3 - hi ≤ k := by dsimp [k]; linarith [hb.2, hz.2]
  have hdiff : 1 / 3 - hi - root ≤ k - alpha := by
    dsimp [k, alpha]
    have halpha : min C0 (Real.sqrt Q) ≤ root :=
      (min_le_right _ _).trans hroot
    linarith [hb.2, hz.2]
  have hD : Dmin ≤ D := by
    dsimp [Dmin, D]
    have h1 : 0 ≤ (k - (1 / 3 - hi)) * (k - alpha) := by
      apply mul_nonneg (by linarith [hkc])
      linarith [hdiff, hC]
    have h2 : 0 ≤ (1 / 3 - hi) *
        ((k - alpha) - (1 / 3 - hi - root)) :=
      mul_nonneg hCmin.le (by linarith [hdiff])
    nlinarith
  have hDpos : 0 < D := lt_of_lt_of_le hDmin hD
  have hqmaxpos : 0 ≤ qmax := hq.trans hqmax
  have hratio : Q / D ≤ qmax / Dmin := by
    apply (div_le_div_iff₀ hDpos hDmin).mpr
    have h1 : Q * Dmin ≤ qmax * Dmin :=
      mul_le_mul_of_nonneg_right hqmax hDmin.le
    have h2 : qmax * Dmin ≤ qmax * D :=
      mul_le_mul_of_nonneg_left hD hqmaxpos
    nlinarith
  have hkpos : 0 < k := by linarith [hkc, hCmin]
  have heta : (2 / 3 - b - z) / k ≤ 2 := by
    apply (div_le_iff₀ hkpos).mpr
    dsimp [k]
    linarith [hz.2]
  have hR : min b (((2 / 3 - b - z) + b - 1547 / 4026) / (9 / 11)) ≤ b :=
    min_le_left _ _
  have hbr : 0 ≤ b - 77 / 1098 := by linarith [hlo, hb.1]
  have hbi : b - 77 / 1098 ≤ hi - 77 / 1098 := by linarith [hb.2]
  have hI : (b - 77 / 1098) *
      ((2 / 3 - b - z) / k + Q / D) ≤
      (hi - 77 / 1098) * (2 + qmax / Dmin) := by
    have hqratio := add_le_add heta hratio
    have hsumpos : 0 ≤ 2 + qmax / Dmin := by positivity
    have hmul := mul_le_mul_of_nonneg_left hqratio hbr
    nlinarith [mul_nonneg (sub_nonneg.mpr hbi) hsumpos]
  unfold enlargedF
  dsimp only
  dsimp only [Q, D, k, alpha] at hI
  nlinarith [hmargin, hI, hz.2, hR]


