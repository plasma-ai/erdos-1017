private def rQfun (b : ℝ) : ℝ :=
  3509 / 14884 - (1 / 3 : ℝ) ^ 2 - 2 * (1547 / 4026 : ℝ) * b - 7 / 11 * b ^ 2
private def rEta (b : ℝ) : ℝ := 1547 / 4026 - 2 / 11 * b
private def rQ (b z : ℝ) : ℝ := rQfun b - z ^ 2
private def rH0 (b z : ℝ) : ℝ :=
  3509 / 14884 - (1 / 3 : ℝ) ^ 2 - b ^ 2 - z ^ 2
private def rTarget (b z : ℝ) : ℝ :=
  1 / 3 + 2 * (77 / 1098 : ℝ) / 5 - 29 * b / 18 - 7 * z / 18
private def rM (b z : ℝ) : ℝ :=
  rTarget b z * (1 / 3 - z) - (b - 77 / 1098) * rEta b
private def rP (b z : ℝ) : ℝ :=
  (1 / 3 - z) * rM b z - (b - 77 / 1098) * rQ b z
private def rS (b z : ℝ) : ℝ := rP b z ^ 2 - rM b z ^ 2 * rQ b z
private def rP0 (b z : ℝ) : ℝ :=
  2 * b * rTarget b z * (1 / 3 - z) - (b - 77 / 1098) * rH0 b z
private def rQzero (b z : ℝ) : ℝ :=
  let v0 : ℝ := 121 / 162
  let w := 1 / 3 + 2 * (77 / 1098 : ℝ) / 5 + v0 * (1547 / 4026) -
    (1 + v0) * b - 7 * z / 18
  2 * b * (1 / 3 - z) * w -
    rH0 b z * ((b - 77 / 1098) + v0 * (1 / 3 - z))


