private theorem rhi_boundary_signs {b z : ℝ}
    (hb : b ∈ Icc (1 / 8 : ℝ) (3 / 20))
    (hz : 0 ≤ z) (hq : 0 ≤ rQ b z) :
    0 < rM b z ∧ 0 < rP b z ∧ 0 < rS b z ∧ 0 < rP0 b z := by
  let N : ℝ := 4 * rQfun b + 1 / 16
  have hN : 0 < N := by
    dsimp [N, rQ] at *
    nlinarith [sq_nonneg z]
  have hcap : z ≤ N := by
    dsimp [N, rQ, rQfun] at *
    nlinarith [sq_nonneg (z - 1 / 8)]
  let x : I := ⟨(b - 1 / 8) / (3 / 20 - 1 / 8), by
    constructor <;> norm_num at * <;> linarith [hb.1, hb.2]⟩
  let y : I := ⟨z / N, by
    constructor
    · exact div_nonneg hz hN.le
    · exact (div_le_one hN).mpr hcap⟩
  have hbAffine : b = rhiChartB x := by
    dsimp [rhiChartB, x]
    field_simp
    ring_nf
  have hzBasic : z = N * (y : ℝ) := by
    dsimp only [y]
    field_simp [hN.ne']
  have hzAffine : z = rhiChartZ x y := by
    dsimp only [rhiChartZ]
    rw [← hbAffine]
    exact hzBasic
  rw [hbAffine, hzAffine]
  exact ⟨rhiM_chart_pos x y, rhiP_chart_pos x y,
    rhiS_chart_pos x y, rhiP0_chart_pos x y⟩

private theorem r_boundary_signs {b z : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b) (hq : 0 ≤ rQ b z) :
    0 < rM b z ∧ 0 < rP b z ∧ 0 < rS b z ∧ 0 < rP0 b z := by
  by_cases hcut : b ≤ 1 / 8
  · exact rlo_boundary_signs ⟨hb.1, hcut⟩ hz
  · exact rhi_boundary_signs ⟨by linarith, r_boundary_b_le hq⟩ hz.1 hq


private theorem enlargedF_etaR_neg {b z : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (hq : 0 ≤ rQ b z)
    (hpole : Real.sqrt (rQ b z) < 1 / 3 - z) :
    enlargedF b z (rEta b) < 0 := by
  have hsigns := r_boundary_signs hb hz hq
  have hk : 0 < 1 / 3 - z := by linarith [hz.2, hb.2]
  have hrb : 0 ≤ b - 77 / 1098 := by linarith [hb.1]
  have hqeq : enlargedQ b z (rEta b) = rQ b z := by
    unfold enlargedQ rEta rQ rQfun
    ring_nf
  have hR : min b ((rEta b + b - 1547 / 4026) / (9 / 11)) = b := by
    have heq : (rEta b + b - 1547 / 4026) / (9 / 11) = b := by
      unfold rEta
      ring_nf
    rw [heq, min_self]
  have hbound := radical_boundary_formula_neg
    (alpha := min (1 / 3 - b) (Real.sqrt (rQ b z)))
    hk hq hpole hsigns.2.1 hsigns.2.2.1
    (show rP b z = (1 / 3 - z) * rM b z -
      (b - 77 / 1098) * rQ b z from rfl)
    (show rM b z = rTarget b z * (1 / 3 - z) -
      (b - 77 / 1098) * rEta b from rfl)
    hrb (min_le_right _ _)
  unfold enlargedF
  rw [hqeq, hR]
  dsimp only
  dsimp [rTarget] at hbound
  nlinarith [hbound]


private theorem enlargedF_Qzero_form {b z eta : ℝ}
    (hq : enlargedQ b z eta = 0) :
    enlargedF b z eta =
      (b - 77 / 1098) * (eta / (1 / 3 - z)) +
        7 * z / 18 +
        11 * min b ((eta + b - 1547 / 4026) / (9 / 11)) / 18 -
        (1 / 3 - b) - 2 * (77 / 1098) / 5 := by
  simp [enlargedF, hq]

private theorem enlargedF_Qzero_Rbig_neg {b z eta : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (hQ : enlargedQ b z eta = 0)
    (heta : rEta b ≤ eta) :
    enlargedF b z eta < 0 := by
  have hk : 0 < 1 / 3 - z := by linarith [hz.2, hb.2]
  have hbpos : 0 < b := by linarith [hb.1]
  have hH0 : rH0 b z = 2 * b * eta := by
    unfold enlargedQ at hQ
    unfold rH0
    nlinarith [hQ]
  have hrq : 0 ≤ rQ b z := by
    dsimp [rH0] at hH0
    dsimp [rQ, rQfun, rEta] at *
    nlinarith [mul_nonneg hbpos.le (sub_nonneg.mpr heta)]
  have hP0 := (r_boundary_signs hb hz hrq).2.2.2
  have hR : min b ((eta + b - 1547 / 4026) / (9 / 11)) = b := by
    rw [min_eq_left]
    apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 9 / 11)).mpr
    dsimp [rEta] at heta
    nlinarith [heta]
  rw [enlargedF_Qzero_form hQ, hR]
  have hnum : (b - 77 / 1098) * eta <
      rTarget b z * (1 / 3 - z) := by
    by_contra! hbad
    have hmul := mul_nonneg hbpos.le (sub_nonneg.mpr hbad)
    dsimp [rP0] at hP0
    nlinarith [hP0, hH0, hmul]
  have hdiv : (b - 77 / 1098) * eta / (1 / 3 - z) <
      rTarget b z := (div_lt_iff₀ hk).mpr hnum
  have hdiv' : (b - 77 / 1098) * (eta / (1 / 3 - z)) <
      rTarget b z := by
    convert hdiv using 1; ring_nf
  dsimp [rTarget] at hdiv'
  nlinarith [hdiv']


private theorem rmoQzero_sign {b z : ℝ}
    (hb : b ∈ Icc (1 / 8 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b) : 0 < rQzero b z := by
