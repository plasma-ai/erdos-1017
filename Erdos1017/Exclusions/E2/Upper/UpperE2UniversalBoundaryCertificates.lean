private def kinkPower (x y : ℝ) : ℝ :=
  ∑ i : Fin 7, ∑ j : Fin 5,
    kinkPowerCoeff i j * x ^ i.val * y ^ j.val

set_option maxHeartbeats 10000000 in
private theorem kinkBernstein_eq_power (x y : I) :
    (∑ i : Fin 7, ∑ j : Fin 5,
      kinkCoeff i j * bernstein 6 i x * bernstein 4 j y) =
      kinkPower x y := by
  norm_num [kinkCoeff, kinkPower, kinkPowerCoeff,
    Fin.sum_univ_succ, bernstein_apply, Nat.choose]
  ring_nf

private def kinkChartB (x : ℝ) : ℝ := kinkB0 + (kinkBmax - kinkB0) * x
private def kinkChartNum (x : ℝ) : ℝ :=
  kinkK2 + (1 / 40 : ℝ) ^ 2 - 2 * kinkChartB x * kinkT
private def kinkChartDen (x : ℝ) : ℝ :=
  2 * (1 / 40 + (4 / 5 : ℝ) * kinkChartB x)

set_option maxHeartbeats 10000000 in
private theorem kinkChart_eq_power (x y : ℝ) :
    -kinkHomogeneous (kinkChartB x) (kinkChartNum x) (kinkChartDen x) y =
      kinkPower x y := by
  dsimp [kinkChartB, kinkChartNum, kinkChartDen, kinkHomogeneous,
    kinkPower, kinkPowerCoeff, kinkB0, kinkBmax, kinkK2, kinkT]
  norm_num [Fin.sum_univ_succ]
  ring_nf

set_option maxHeartbeats 10000000 in
private theorem kinkNumerator_neg {b y : ℝ}
    (hb : b ∈ Icc kinkB0 kinkBmax) (hy : y ∈ Icc (0 : ℝ) 1) :
    kinkNumerator b (kinkZbar b * y) < 0 := by
  let x : I := ⟨(b - kinkB0) / (kinkBmax - kinkB0), by
    constructor <;> norm_num [kinkB0, kinkBmax] at * <;> linarith [hb.1, hb.2]⟩
  let w : I := ⟨y, hy⟩
  have hpos := bernstein_sum₂_pos 6 4 (1 / 1000000000) (by norm_num)
    kinkCoeff (by intro i j; fin_cases i <;> fin_cases j <;> norm_num [kinkCoeff]) x w
  have hden : 0 < 2 * (1 / 40 + (4 / 5 : ℝ) * b) := by
    dsimp [kinkB0] at hb
    linarith [hb.1]
  have hden0 : 1 / 40 + (4 / 5 : ℝ) * b ≠ 0 := by linarith [hden]
  have hbAffine : b = kinkB0 + (kinkBmax - kinkB0) * (x : ℝ) := by
    dsimp [x]
    have hlen : kinkBmax - kinkB0 ≠ 0 := by
      norm_num [kinkBmax, kinkB0]
    field_simp [hlen]
    ring_nf
  have hhom := kinkHomogeneous_eq b
    (kinkK2 + (1 / 40 : ℝ) ^ 2 - 2 * b * kinkT)
    (2 * (1 / 40 + (4 / 5 : ℝ) * b)) y hden.ne'
  have heq : -(kinkNumerator b (kinkZbar b * y)) *
        (2 * (1 / 40 + (4 / 5 : ℝ) * b)) ^ 4 =
      ∑ i : Fin 7, ∑ j : Fin 5,
        kinkCoeff i j * bernstein 6 i x * bernstein 4 j w := by
    rw [kinkBernstein_eq_power]
    have hc := kinkChart_eq_power (x : ℝ) y
    dsimp [kinkChartB, kinkChartNum, kinkChartDen] at hc
    rw [← hbAffine] at hc
    rw [← hc]
    dsimp [kinkZbar] at hhom ⊢
    calc
      _ = -((2 * (1 / 40 + (4 / 5 : ℝ) * b)) ^ 4 *
          kinkNumerator b ((kinkK2 + (1 / 40 : ℝ) ^ 2 - 2 * b * kinkT) * y /
            (2 * (1 / 40 + (4 / 5 : ℝ) * b)))) := by ring_nf
      _ = -kinkHomogeneous b (kinkK2 + (1 / 40 : ℝ) ^ 2 - 2 * b * kinkT)
          (2 * (1 / 40 + (4 / 5 : ℝ) * b)) y := by rw [hhom]
  rw [← heq] at hpos
  have hpow : 0 < (2 * (1 / 40 + (4 / 5 : ℝ) * b)) ^ 4 := pow_pos hden 4
  nlinarith


private def loD (b z : ℝ) : ℝ :=
  let a : ℝ := 1 / 3
  let b0 : ℝ := 77 / 1098
  let T0 : ℝ := 1547 / 4026
  let L : ℝ := 4 / 5
  let E : ℝ := 9 / 11
  let k := a - z
  let eta := T0 - b + L * z
  let az := 7 / 18 + L / (2 * E ^ 2)
  let target := a - b + 2 * b0 / 5 - az * z
  target * k - (b - b0) * eta

