private def kinkPolyN (b z : ℝ) : ℝ :=
  (-26137573 / 1985629788 * b + 880543 / 54252180 * b ^ 2) +
    (-4806263 / 1985629788 + 31399649 / 108504360 * b -
      61589 / 148230 * b ^ 2) * z +
    (219373 / 21700872 - 61117 / 49410 * b + 2 / 9 * b ^ 2) * z ^ 2 +
    (2651 / 14823 + 409 / 162 * b) * z ^ 3 - 121 / 162 * z ^ 4

private theorem kinkNumerator_eq_polyN (b z : ℝ) :
    kinkNumerator b z = kinkPolyN b z := by
  unfold kinkNumerator kinkPolyN kinkK2 kinkT
  ring_nf

private def kinkHomogeneous (b num den y : ℝ) : ℝ :=
  (-26137573 / 1985629788 * b + 880543 / 54252180 * b ^ 2) * den ^ 4 +
    (-4806263 / 1985629788 + 31399649 / 108504360 * b -
      61589 / 148230 * b ^ 2) * (num * y) * den ^ 3 +
    (219373 / 21700872 - 61117 / 49410 * b + 2 / 9 * b ^ 2) *
      (num * y) ^ 2 * den ^ 2 +
    (2651 / 14823 + 409 / 162 * b) * (num * y) ^ 3 * den -
      121 / 162 * (num * y) ^ 4

private theorem kinkHomogeneous_eq (b num den y : ℝ) (hden : den ≠ 0) :
    den ^ 4 * kinkNumerator b (num * y / den) =
      kinkHomogeneous b num den y := by
  rw [kinkNumerator_eq_polyN]
  unfold kinkPolyN kinkHomogeneous
  field_simp [hden]

