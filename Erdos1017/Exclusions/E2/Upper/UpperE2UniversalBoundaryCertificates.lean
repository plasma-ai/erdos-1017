private theorem rQ_neg_imp_b_gt_eighth {b z : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (hq : rQ b z < 0) : 1 / 8 < b := by
  by_contra! hbad
  have hmon : 0 ≤ (1 / 8 - b) *
      (2 * (1547 / 4026 : ℝ) + 7 / 11 * (b + 1 / 8)) := by
    apply mul_nonneg (by linarith [hbad])
    nlinarith [hb.1]
  have hsq : 0 ≤ (b - z) * (b + z) := by
    apply mul_nonneg (by linarith [hz.2])
    linarith [hb.1, hz.1]
  have hsq2 : 0 ≤ (1 / 8 - b) * (1 / 8 + b) := by
    apply mul_nonneg (by linarith [hbad])
    linarith [hb.1]
  dsimp [rQ, rQfun] at hq
  nlinarith [hmon, hsq, hsq2]

private theorem enlargedF_Qzero_Rsmall_neg {b z eta : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (hQ : enlargedQ b z eta = 0)
    (heta : eta < rEta b) :
    enlargedF b z eta < 0 := by
  have hk : 0 < 1 / 3 - z := by linarith [hz.2, hb.2]
  have hbpos : 0 < b := by linarith [hb.1]
  have hH0 : rH0 b z = 2 * b * eta := by
    unfold enlargedQ at hQ
    unfold rH0
    nlinarith [hQ]
  have hrq : rQ b z < 0 := by
    dsimp [rH0] at hH0
    dsimp [rQ, rQfun, rEta] at *
    have hmul := mul_pos hbpos (sub_pos.mpr heta)
    nlinarith [hH0, hmul]
  have hblow := rQ_neg_imp_b_gt_eighth hb hz hrq
  have hQzero := rmoQzero_sign ⟨hblow.le, hb.2⟩ hz
  have hR : min b ((eta + b - 1547 / 4026) / (9 / 11)) =
      (eta + b - 1547 / 4026) / (9 / 11) := by
    apply min_eq_right
    apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 9 / 11)).mpr
    dsimp [rEta] at heta
    nlinarith [heta]
  rw [enlargedF_Qzero_form hQ, hR]
  have hqeq : rQzero b z = 2 * b *
      ((1 / 3 - z) * (1 / 3 - b + 2 * (77 / 1098 : ℝ) / 5 - 7 * z / 18) -
        (b - 77 / 1098) * eta -
          (121 / 162 : ℝ) * (1 / 3 - z) * (eta + b - 1547 / 4026)) := by
    dsimp [rQzero]
    rw [hH0]
    ring_nf
  have hnum : (b - 77 / 1098) * eta +
      (121 / 162 : ℝ) * (1 / 3 - z) * (eta + b - 1547 / 4026) <
      (1 / 3 - z) * (1 / 3 - b + 2 * (77 / 1098 : ℝ) / 5 - 7 * z / 18) := by
    have hpositive : 0 <
        (1 / 3 - z) * (1 / 3 - b + 2 * (77 / 1098 : ℝ) / 5 - 7 * z / 18) -
          (b - 77 / 1098) * eta -
            (121 / 162 : ℝ) * (1 / 3 - z) * (eta + b - 1547 / 4026) := by
      apply (mul_pos_iff_of_pos_left (by positivity : 0 < 2 * b)).mp
      rw [← hqeq]
      exact hQzero
    linarith [hpositive]
  have hdiv : ((b - 77 / 1098) * eta +
      (121 / 162 : ℝ) * (1 / 3 - z) * (eta + b - 1547 / 4026)) /
        (1 / 3 - z) <
      1 / 3 - b + 2 * (77 / 1098 : ℝ) / 5 - 7 * z / 18 := by
    apply (div_lt_iff₀ hk).mpr
    nlinarith [hnum]
  have hcost : (b - 77 / 1098) * (eta / (1 / 3 - z)) +
      11 * ((eta + b - 1547 / 4026) / (9 / 11)) / 18 =
      ((b - 77 / 1098) * eta +
        (121 / 162 : ℝ) * (1 / 3 - z) * (eta + b - 1547 / 4026)) /
          (1 / 3 - z) := by
    calc
      _ = (b - 77 / 1098) * eta / (1 / 3 - z) +
          (121 / 162 : ℝ) * (eta + b - 1547 / 4026) := by ring_nf
      _ = _ := by
        apply (eq_div_iff hk.ne').mpr
        rw [add_mul, div_mul_cancel₀ _ hk.ne']
        ring_nf
  nlinarith [hcost, hdiv]


private theorem enlargedF_Qzero_neg {b z eta : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (hQ : enlargedQ b z eta = 0) :
    enlargedF b z eta < 0 := by
  by_cases heta : rEta b ≤ eta
  · exact enlargedF_Qzero_Rbig_neg hb hz hQ heta
  · exact enlargedF_Qzero_Rsmall_neg hb hz hQ (lt_of_not_ge heta)

private def kinkEtaC (b z : ℝ) : ℝ :=
  (3509 / 14884 - (1 / 3 : ℝ) ^ 2 - b ^ 2 - z ^ 2 -
    (1 / 3 - b) ^ 2) / (2 * b)
private theorem kink_Q_eq {b z : ℝ} (hb : b ≠ 0) :
    enlargedQ b z (kinkEtaC b z) = (1 / 3 - b) ^ 2 := by
  unfold enlargedQ kinkEtaC
  field_simp [hb]
  ring_nf

private theorem kink_R_moving {b z : ℝ}
    (hb : 77 / 1098 ≤ b) :
    min b ((kinkEtaC b z + b - 1547 / 4026) / (9 / 11)) =
      (kinkEtaC b z + b - 1547 / 4026) / (9 / 11) := by
  have hbpos : 0 < b := by linarith [hb]
  apply min_eq_right
  apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 9 / 11)).mpr
  unfold kinkEtaC
  have hmon : 0 ≤ (b - 77 / 1098) *
      (2 * (1547 / 4026 - 1 / 3 + (9 / 11 : ℝ) * (b + 77 / 1098))) := by
    apply mul_nonneg (by linarith [hb])
    nlinarith [hb]
  field_simp [hbpos.ne']
  nlinarith [hmon, sq_nonneg z]

private theorem kink_clear_generic
    (b b0 z k C eta R : ℝ) (hk : k ≠ 0) (hkc : k - C ≠ 0) :
    2 * b * k * (k - C) *
        ((b - b0) * (eta / k + C ^ 2 / (k * (k - C))) +
          7 * z / 18 + 11 * R / 18 - C - 2 * b0 / 5) =
      (b - b0) * (2 * b * eta * (k - C) + 2 * b * C ^ 2) +
        2 * b * k * (k - C) * (7 * z / 18 - C - 2 * b0 / 5) +
          (11 / 9 : ℝ) * b * k * (k - C) * R := by
  field_simp [hk, hkc]
  ring_nf


private theorem kink_algebra {b z : ℝ}
    (hb : 0 < b) (hC : 0 ≤ 1 / 3 - b)
    (hk : 0 < 1 / 3 - z) (hbz : 0 < b - z)
    (hR : min b ((kinkEtaC b z + b - 1547 / 4026) / (9 / 11)) =
      (kinkEtaC b z + b - 1547 / 4026) / (9 / 11)) :
    2 * b * (1 / 3 - z) * (b - z) * enlargedF b z (kinkEtaC b z) =
      kinkNumerator b z := by
  have hQ := kink_Q_eq (b := b) (z := z) hb.ne'
  have hsqrt : Real.sqrt ((1 / 3 - b) ^ 2) = 1 / 3 - b :=
    Real.sqrt_sq_eq_abs _ |>.trans (abs_of_nonneg hC)
  let k : ℝ := 1 / 3 - z
  let C : ℝ := 1 / 3 - b
  let R : ℝ := (kinkEtaC b z + b - 1547 / 4026) / (9 / 11)
  have hk' : k ≠ 0 := hk.ne'
  have hkc : k - C ≠ 0 := by dsimp [k, C]; linarith [hbz]
  have hclear := kink_clear_generic b (77 / 1098) z k C
    (kinkEtaC b z) R hk' hkc
  have hleft : 2 * b * k * (k - C) * enlargedF b z (kinkEtaC b z) =
      (b - 77 / 1098) *
          (2 * b * kinkEtaC b z * (k - C) + 2 * b * C ^ 2) +
        2 * b * k * (k - C) * (7 * z / 18 - C - 2 * (77 / 1098) / 5) +
          (11 / 9 : ℝ) * b * k * (k - C) * R := by
    convert hclear using 1
    unfold enlargedF
    dsimp only
    rw [hQ, hsqrt, min_self, hR]
  have hetaNum : 2 * b * kinkEtaC b z = 2 * b * C + kinkK2 - z ^ 2 := by
    dsimp [kinkEtaC, C, kinkK2]
    field_simp [hb.ne']
    ring_nf
  have hRNum : (11 / 9 : ℝ) * b * R =
      (121 / 162 : ℝ) * (kinkK2 - z ^ 2 - 2 * b * kinkT) := by
    calc
      _ = (121 / 162 : ℝ) *
          (2 * b * (kinkEtaC b z + b - 1547 / 4026)) := by
            dsimp [R]
            ring_nf
      _ = _ := by
        dsimp [kinkT, C] at *
        linear_combination (121 / 162 : ℝ) * hetaNum
  dsimp only [k, C] at hleft
  calc
    _ = (b - 77 / 1098) *
          (2 * b * kinkEtaC b z * (b - z) + 2 * b * (1 / 3 - b) ^ 2) +
        2 * b * (1 / 3 - z) * (b - z) *
          (7 * z / 18 - (1 / 3 - b) - 2 * (77 / 1098) / 5) +
          (11 / 9 : ℝ) * b * (1 / 3 - z) * (b - z) * R := by
      linear_combination hleft
    _ = kinkNumerator b z := by
      dsimp [kinkNumerator]
      linear_combination (b - 77 / 1098) * (b - z) * hetaNum +
        (1 / 3 - z) * (b - z) * hRNum


private theorem kink_domain_chart {b z : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (heta : 1547 / 4026 - b + (4 / 5 : ℝ) * z ≤ kinkEtaC b z) :
    b ≤ 19943 / 150060 ∧
      0 < (kinkK2 + (1 / 40 : ℝ) ^ 2 - 2 * b * kinkT) /
        (2 * (1 / 40 + (4 / 5 : ℝ) * b)) ∧
      z ≤ (kinkK2 + (1 / 40 : ℝ) ^ 2 - 2 * b * kinkT) /
        (2 * (1 / 40 + (4 / 5 : ℝ) * b)) := by
  have hbpos : 0 < b := by linarith [hb.1]
  have ht : 0 < kinkT := by norm_num [kinkT]
  have hmass : z ^ 2 + 2 * b * (kinkT + (4 / 5 : ℝ) * z) ≤ kinkK2 := by
    dsimp [kinkEtaC, kinkK2, kinkT] at heta ⊢
    have hmul := mul_nonneg hbpos.le (sub_nonneg.mpr heta)
    field_simp [hbpos.ne'] at hmul
    nlinarith [hmul]
  have hbmax : b ≤ 19943 / 150060 := by
    unfold kinkK2 kinkT at hmass
    nlinarith [hmass, sq_nonneg z,
      mul_nonneg hbpos.le (mul_nonneg (by norm_num : (0 : ℝ) ≤ 4 / 5) hz.1)]
  have hden : 0 < 2 * (1 / 40 + (4 / 5 : ℝ) * b) := by
    linarith [hb.1]
  have hnum : 0 < kinkK2 + (1 / 40 : ℝ) ^ 2 - 2 * b * kinkT := by
    unfold kinkK2 kinkT
    nlinarith [hbmax]
  have hcap : z ≤ (kinkK2 + (1 / 40 : ℝ) ^ 2 - 2 * b * kinkT) /
      (2 * (1 / 40 + (4 / 5 : ℝ) * b)) := by
    apply (le_div_iff₀ hden).mpr
    nlinarith [hmass, sq_nonneg (z - 1 / 40)]
  exact ⟨hbmax, div_pos hnum hden, hcap⟩



private theorem enlargedF_etaC_neg {b z : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (heta : 1547 / 4026 - b + (4 / 5 : ℝ) * z ≤ kinkEtaC b z) :
    enlargedF b z (kinkEtaC b z) < 0 := by
  have hbpos : 0 < b := by linarith [hb.1]
  have hk : 0 < 1 / 3 - z := by linarith [hz.2, hb.2]
  have hC : 0 ≤ 1 / 3 - b := by linarith [hb.2]
  have hQ : enlargedQ b z (kinkEtaC b z) = (1 / 3 - b) ^ 2 :=
    kink_Q_eq hbpos.ne'
  have hQnonneg : 0 ≤ enlargedQ b z (kinkEtaC b z) := by
    rw [hQ]
    positivity
  have hpole := enlarged_pole_pos hb hz heta hQnonneg
  have hsqrt : Real.sqrt (enlargedQ b z (kinkEtaC b z)) = 1 / 3 - b := by
    rw [hQ, Real.sqrt_sq_eq_abs, abs_of_nonneg hC]
  have hbz : 0 < b - z := by
    rw [hsqrt, min_self] at hpole
    nlinarith [hpole]
  have hR := kink_R_moving hb.1 (z := z)
  have hclear := kink_algebra hbpos hC hk hbz hR
  have hchart := kink_domain_chart hb hz heta
  let Z : ℝ := kinkZbar b
  have hZpos : 0 < Z := hchart.2.1
  let y : I := ⟨z / Z, by
    constructor
    · exact div_nonneg hz.1 hZpos.le
    · exact (div_le_one hZpos).mpr hchart.2.2⟩
  have hZ : z = kinkZbar b * (y : ℝ) := by
    dsimp only [y]
    change z = Z * (z / Z)
    field_simp [hZpos.ne']
  have hN := kinkNumerator_neg ⟨hb.1, hchart.1⟩ y.property
  rw [← hZ] at hN
  have hfactor : 0 < 2 * b * (1 / 3 - z) * (b - z) := by positivity
  nlinarith [hclear, hN]

private theorem enlargedQ_lt_k_sq {b z eta : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (heta : 1547 / 4026 - b + (4 / 5 : ℝ) * z ≤ eta) :
    enlargedQ b z eta < (1 / 3 - z) ^ 2 := by
  unfold enlargedQ
  by_cases hsmall : b ≤ 1 / 9
  · have hfactor : 0 ≤ (b - z) *
        (2 / 3 - (8 / 5 : ℝ) * b - 2 * (z + b)) :=
      mul_nonneg (sub_nonneg.mpr hz.2) (by linarith [hz.2, hsmall])
    have hbase : 0 < 1 / 9 - (3509 / 14884 - (1 / 3 : ℝ) ^ 2) +
        (13 / 5 : ℝ) * b ^ 2 +
        (2 * (1547 / 4026 : ℝ) - 2 / 3) * b := by
      nlinarith [hb.1, sq_nonneg b]
    nlinarith [hfactor, hbase,
      mul_nonneg (by linarith [hb.1] : 0 ≤ b)
        (sub_nonneg.mpr heta)]
  · have hbq : b ^ 2 ≤ b / 4 := by
      nlinarith [mul_nonneg (by linarith [hb.1] : 0 ≤ b)
        (sub_nonneg.mpr hb.2)]
    have hbase : 0 < 1 / 9 - (3509 / 14884 - (1 / 3 : ℝ) ^ 2) -
        1 / 18 + (2 * (1547 / 4026 : ℝ) + 4 / 15 - 33 / 100) * b := by
      linarith [hb.1, hsmall]
    nlinarith [sq_nonneg (z - (1 / 6 - (2 / 5 : ℝ) * b)), hbq,
      hbase,
      mul_nonneg (by linarith [hb.1] : 0 ≤ b)
        (sub_nonneg.mpr heta)]

private def reciprocalRadical (k q : ℝ) : ℝ :=
  q / (k * (k - Real.sqrt q))
private def reciprocalRadicalDeriv (k q : ℝ) : ℝ :=
  (2 * k - Real.sqrt q) / (2 * k * (k - Real.sqrt q) ^ 2)
private def reciprocalRadicalDeriv2 (k q : ℝ) : ℝ :=
  (3 * k - Real.sqrt q) /
    (4 * k * Real.sqrt q * (k - Real.sqrt q) ^ 3)

private theorem reciprocalRadical_hasDerivAt (k q : ℝ)
    (hq : 0 < q) (hk : Real.sqrt q < k) :
    HasDerivAt (reciprocalRadical k) (reciprocalRadicalDeriv k q) q := by
  have hs : 0 < Real.sqrt q := Real.sqrt_pos.2 hq
  have hden : 0 < k * (k - Real.sqrt q) :=
    mul_pos (lt_trans hs hk) (sub_pos.mpr hk)
  have hS := Real.hasDerivAt_sqrt hq.ne'
  have hD : HasDerivAt (fun x : ℝ => k * (k - Real.sqrt x))
      (-k / (2 * Real.sqrt q)) q := by
    convert (hS.const_sub k).const_mul k using 1; ring_nf
  have hId : HasDerivAt (fun x : ℝ => x) 1 q := hasDerivAt_id q
  have hG := hId.div hD hden.ne'
  convert hG using 1
  · rfl
  · dsimp [reciprocalRadicalDeriv]
    have hsq : (Real.sqrt q) ^ 2 = q := Real.sq_sqrt hq.le
    rw [← hsq]
    simp only [Real.sqrt_sq_eq_abs, abs_of_nonneg (Real.sqrt_nonneg q)]
    field_simp [hs.ne', hden.ne']
    ring_nf


private theorem reciprocalRadicalDeriv_hasDerivAt (k q : ℝ)
    (hq : 0 < q) (hk : Real.sqrt q < k) :
    HasDerivAt (reciprocalRadicalDeriv k)
      (reciprocalRadicalDeriv2 k q) q := by
  have hs : 0 < Real.sqrt q := Real.sqrt_pos.2 hq
  have hkpos : 0 < k := lt_trans hs hk
  have hks : 0 < k - Real.sqrt q := sub_pos.mpr hk
  have hS := Real.hasDerivAt_sqrt hq.ne'
  have hN : HasDerivAt (fun x : ℝ => 2 * k - Real.sqrt x)
      (-(1 / (2 * Real.sqrt q))) q := by
    exact hS.const_sub (2 * k)
  have hD : HasDerivAt
      (fun x : ℝ => 2 * k * (k - Real.sqrt x) ^ 2)
      (-(2 * k * (k - Real.sqrt q) / Real.sqrt q)) q := by
    have h0 := (hS.const_sub k).pow 2
    convert h0.const_mul (2 * k) using 1
    field_simp [hs.ne']
    ring_nf
  have hden : 0 < 2 * k * (k - Real.sqrt q) ^ 2 := by positivity
  have hG := hN.div hD hden.ne'
  convert hG using 1
  · rfl
  · dsimp [reciprocalRadicalDeriv2]
    field_simp [hs.ne', hkpos.ne', hks.ne']
    ring_nf


private theorem reciprocalRadical_convexOn (k c : ℝ)
    (hk : 0 < k) (hck : c < k ^ 2) :
    ConvexOn ℝ (Icc (0 : ℝ) c) (reciprocalRadical k) := by
  have hroot : ∀ q ∈ Icc (0 : ℝ) c, Real.sqrt q < k := by
    intro q hq
    have hsq : (Real.sqrt q) ^ 2 = q := Real.sq_sqrt hq.1
    have hnonneg := Real.sqrt_nonneg q
    nlinarith [hq.2]
  have hcont : ContinuousOn (reciprocalRadical k) (Icc (0 : ℝ) c) := by
    unfold reciprocalRadical
    apply ContinuousOn.div continuousOn_id
      ((continuousOn_const.sub Real.continuous_sqrt.continuousOn).const_mul k)
    intro q hq
    exact (mul_pos hk (sub_pos.mpr (hroot q hq))).ne'
  apply convexOn_of_hasDerivWithinAt2_nonneg (convex_Icc _ _) hcont
  · intro q hq
    rw [interior_Icc] at hq
    exact (reciprocalRadical_hasDerivAt k q hq.1
      (hroot q ⟨hq.1.le, hq.2.le⟩)).hasDerivWithinAt
  · intro q hq
    rw [interior_Icc] at hq
    exact (reciprocalRadicalDeriv_hasDerivAt k q hq.1
      (hroot q ⟨hq.1.le, hq.2.le⟩)).hasDerivWithinAt
  · intro q hq
    rw [interior_Icc] at hq
    have hq0 : 0 < q := hq.1
    have hks : Real.sqrt q < k := hroot q ⟨hq.1.le, hq.2.le⟩
    have hs : 0 < Real.sqrt q := Real.sqrt_pos.2 hq0
    have hnum : 0 < 3 * k - Real.sqrt q := by linarith [hk, hks]
    unfold reciprocalRadicalDeriv2
    exact div_nonneg hnum.le (by positivity)

private theorem affine_reciprocal_convexOn
    (k c q0 d A B C : ℝ) (hk : 0 < k) (hck : c < k ^ 2) (hB : 0 ≤ B) :
    ConvexOn ℝ {eta : ℝ | q0 - d * eta ∈ Icc (0 : ℝ) c}
      (fun eta => A * eta + B * (q0 - d * eta) /
        (k * (k - Real.sqrt (q0 - d * eta))) + C) := by
  have hrecip := reciprocalRadical_convexOn k c hk hck
  have hconv : Convex ℝ {eta : ℝ | q0 - d * eta ∈ Icc (0 : ℝ) c} := by
    intro x hx y hy a b ha hb hab
    have hq : q0 - d * (a • x + b • y) =
        a • (q0 - d * x) + b • (q0 - d * y) := by
      simp only [smul_eq_mul]
      calc
        _ = (a + b) * q0 - d * (a * x + b * y) := by rw [hab]; ring
        _ = _ := by ring
    change q0 - d * (a • x + b • y) ∈ Icc (0 : ℝ) c
    rw [hq]
    exact hrecip.1 hx hy ha hb hab
  refine ⟨hconv, ?_⟩
  intro x hx y hy a b ha hb hab
  have hq : q0 - d * (a • x + b • y) =
      a • (q0 - d * x) + b • (q0 - d * y) := by
    simp only [smul_eq_mul]
    calc
      _ = (a + b) * q0 - d * (a * x + b * y) := by rw [hab]; ring
      _ = _ := by ring
  have hg := hrecip.2 hx hy ha hb hab
  dsimp [reciprocalRadical] at hg
  simp only [smul_eq_mul] at hg ⊢
  simp only [smul_eq_mul] at hq
  rw [hq]
  have hscaled := mul_le_mul_of_nonneg_left hg hB
  calc
    _ = A * (a * x + b * y) +
        B * ((a * (q0 - d * x) + b * (q0 - d * y)) /
          (k * (k - Real.sqrt (a * (q0 - d * x) + b * (q0 - d * y))))) + C := by
      ring
    _ ≤ A * (a * x + b * y) +
        B * (a * ((q0 - d * x) / (k * (k - Real.sqrt (q0 - d * x)))) +
          b * ((q0 - d * y) / (k * (k - Real.sqrt (q0 - d * y))))) + C := by
      linarith
    _ = _ := by
      calc
        _ = a * (A * x + B * (q0 - d * x) /
              (k * (k - Real.sqrt (q0 - d * x))) + C) +
            b * (A * y + B * (q0 - d * y) /
              (k * (k - Real.sqrt (q0 - d * y))) + C) +
              (1 - a - b) * C := by ring
        _ = _ := by rw [show 1 - a - b = 0 by linarith [hab]]; ring

private def enlargedFPiece (b z : ℝ) (rCap aCap : Bool) (eta : ℝ) : ℝ :=
  let k := 1 / 3 - z
  let C0 := 1 / 3 - b
  let Q := enlargedQ b z eta
  let R := if rCap then b else (eta + b - 1547 / 4026) / (9 / 11)
  let alpha := if aCap then C0 else Real.sqrt Q
  (b - 77 / 1098) * (eta / k + Q / (k * (k - alpha))) +
    7 * z / 18 + 11 * R / 18 - C0 - 2 * (77 / 1098) / 5

private theorem enlargedF_eq_piece {b z eta : ℝ} {rCap aCap : Bool}
    (hb : 0 < b) (hC : 0 ≤ 1 / 3 - b)
    (hq : 0 ≤ enlargedQ b z eta)
    (hr : if rCap then rEta b ≤ eta else eta ≤ rEta b)
    (ha : if aCap then eta ≤ kinkEtaC b z else kinkEtaC b z ≤ eta) :
    enlargedF b z eta = enlargedFPiece b z rCap aCap eta := by
  have hRlo : eta ≤ rEta b →
      min b ((eta + b - 1547 / 4026) / (9 / 11)) =
        (eta + b - 1547 / 4026) / (9 / 11) := by
    intro h
    apply min_eq_right
    apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 9 / 11)).mpr
    dsimp [rEta] at h
    linarith
  have hRhi : rEta b ≤ eta →
      min b ((eta + b - 1547 / 4026) / (9 / 11)) = b := by
    intro h
    apply min_eq_left
    apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 9 / 11)).mpr
    dsimp [rEta] at h
    linarith
  have hQdiff : enlargedQ b z eta - (1 / 3 - b) ^ 2 =
      2 * b * (kinkEtaC b z - eta) := by
    unfold enlargedQ kinkEtaC
    field_simp [hb.ne']
    ring
  have hsqrt := Real.sq_sqrt hq
  have hminlo : eta ≤ kinkEtaC b z →
      min (1 / 3 - b) (Real.sqrt (enlargedQ b z eta)) = 1 / 3 - b := by
    intro h
    apply min_eq_left
    nlinarith [hQdiff, hsqrt, Real.sqrt_nonneg (enlargedQ b z eta)]
  have hminhi : kinkEtaC b z ≤ eta →
      min (1 / 3 - b) (Real.sqrt (enlargedQ b z eta)) =
        Real.sqrt (enlargedQ b z eta) := by
    intro h
    apply min_eq_right
    nlinarith [hQdiff, hsqrt, Real.sqrt_nonneg (enlargedQ b z eta)]
  cases rCap <;> cases aCap
  · simp only [Bool.false_eq_true, ite_false] at hr ha
    simp only [enlargedF, enlargedFPiece, Bool.false_eq_true, ite_false]
    rw [hRlo hr, hminhi ha]
  · simp at hr ha
    simp only [enlargedF, enlargedFPiece]
    simp only [Bool.false_eq_true, ite_false, ite_true]
    rw [hRlo hr, hminlo ha]
  · simp at hr ha
    simp only [enlargedF, enlargedFPiece]
    simp only [Bool.false_eq_true, ite_false, ite_true]
    rw [hRhi hr, hminhi ha]
  · simp at hr ha
    simp only [enlargedF, enlargedFPiece]
    simp only [ite_true]
    rw [hRhi hr, hminlo ha]

private theorem affine_function_convexOn (A C : ℝ) :
    ConvexOn ℝ (univ : Set ℝ) (fun eta => A * eta + C) := by
  refine ⟨convex_univ, ?_⟩
  intro x _ y _ a b _ _ hab
  simp only [smul_eq_mul]
  apply le_of_eq
  calc
    A * (a * x + b * y) + C =
        a * (A * x + C) + b * (A * y + C) + (1 - a - b) * C := by ring
    _ = _ := by rw [show 1 - a - b = 0 by linarith [hab]]; ring

private def enlargedFPieceLinear (b z : ℝ) (rCap : Bool) (eta : ℝ) : ℝ :=
  (b - 77 / 1098) * eta / (1 / 3 - z) + 7 * z / 18 +
    11 * (if rCap then b else (eta + b - 1547 / 4026) / (9 / 11)) / 18 -
    (1 / 3 - b) - 2 * (77 / 1098) / 5

private theorem enlargedFPieceLinear_affine (b z : ℝ) (rCap : Bool)
    (eta : ℝ) :
    enlargedFPieceLinear b z rCap eta =
      eta * (enlargedFPieceLinear b z rCap 1 -
        enlargedFPieceLinear b z rCap 0) +
        enlargedFPieceLinear b z rCap 0 := by
  cases rCap <;> simp [enlargedFPieceLinear] <;> ring

private theorem enlargedFPiece_capped_convexOn (b z : ℝ) (rCap : Bool) :
    ConvexOn ℝ (univ : Set ℝ) (enlargedFPiece b z rCap true) := by
  let A := enlargedFPiece b z rCap true 1 - enlargedFPiece b z rCap true 0
  let C := enlargedFPiece b z rCap true 0
  have hlinear : ∀ eta : ℝ,
      enlargedFPiece b z rCap true eta = A * eta + C := by
    intro eta
    dsimp only [A, C]
    cases rCap <;> simp only [enlargedFPiece, enlargedQ,
      Bool.false_eq_true, ite_false, ite_true] <;> ring
  convert affine_function_convexOn A C using 1
  ext eta
  exact hlinear eta

private theorem enlargedFPiece_radical_convexOn {b z c : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (hc : c < (1 / 3 - z) ^ 2) (rCap : Bool) :
    ConvexOn ℝ {eta : ℝ | enlargedQ b z eta ∈ Icc (0 : ℝ) c}
      (enlargedFPiece b z rCap false) := by
  let k : ℝ := 1 / 3 - z
  let q0 : ℝ := 3509 / 14884 - (1 / 3 : ℝ) ^ 2 - b ^ 2 - z ^ 2
  let A := enlargedFPieceLinear b z rCap 1 - enlargedFPieceLinear b z rCap 0
  let C := enlargedFPieceLinear b z rCap 0
  have hk : 0 < k := by dsimp [k]; linarith [hz.2, hb.2]
  have hB : 0 ≤ b - 77 / 1098 := sub_nonneg.mpr hb.1
  have hconv := affine_reciprocal_convexOn k c q0 (2 * b) A
    (b - 77 / 1098) C hk hc hB
  have hq : ∀ eta : ℝ, q0 - 2 * b * eta = enlargedQ b z eta := by
    intro eta
    rfl
  have hpiece : ∀ eta : ℝ,
      enlargedFPiece b z rCap false eta =
        A * eta + (b - 77 / 1098) *
          reciprocalRadical k (enlargedQ b z eta) + C := by
    intro eta
    have hlin := enlargedFPieceLinear_affine b z rCap eta
    calc
      _ = enlargedFPieceLinear b z rCap eta +
          (b - 77 / 1098) * reciprocalRadical k (enlargedQ b z eta) := by
        dsimp [enlargedFPiece, enlargedFPieceLinear, reciprocalRadical, k]
        cases rCap <;> simp <;> ring
      _ = _ := by
        dsimp only [A, C]
        rw [hlin]
        ring
  convert hconv using 1
  · ext eta
    change (enlargedQ b z eta ∈ Icc (0 : ℝ) c) ↔
      (q0 - 2 * b * eta ∈ Icc (0 : ℝ) c)
    rw [hq]
  · ext eta
    rw [hpiece eta]
    rw [← hq eta]
    dsimp [reciprocalRadical]
    ring

private theorem enlargedF_piece_le_max {b z x y eta : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (hxlo : 1547 / 4026 - b + (4 / 5 : ℝ) * z ≤ x)
    (hxy : x ≤ y) (hη : eta ∈ Icc x y)
    (hQy : 0 ≤ enlargedQ b z y)
    (rCap aCap : Bool)
    (hr : if rCap then rEta b ≤ x else y ≤ rEta b)
    (ha : if aCap then y ≤ kinkEtaC b z else kinkEtaC b z ≤ x) :
    enlargedF b z eta ≤ max (enlargedF b z x) (enlargedF b z y) := by
  have hbpos : 0 < b := by linarith [hb.1]
  have hC : 0 ≤ 1 / 3 - b := by linarith [hb.2]
  have hQat : ∀ t ∈ Icc x y, 0 ≤ enlargedQ b z t := by
    intro t ht
    have hmul := mul_nonneg hbpos.le (sub_nonneg.mpr ht.2)
    unfold enlargedQ at hQy ⊢
    nlinarith
  have hR_at : ∀ t ∈ Icc x y,
      if rCap then rEta b ≤ t else t ≤ rEta b := by
    intro t ht
    cases rCap with
    | false => simpa using ht.2.trans hr
    | true => simpa using hr.trans ht.1
  have hA_at : ∀ t ∈ Icc x y,
      if aCap then t ≤ kinkEtaC b z else kinkEtaC b z ≤ t := by
    intro t ht
    cases aCap with
    | false => simpa using ha.trans ht.1
    | true => simpa using ht.2.trans ha
  have hxmem : x ∈ Icc x y := ⟨le_rfl, hxy⟩
  have hymem : y ∈ Icc x y := ⟨hxy, le_rfl⟩
  have hFx := enlargedF_eq_piece hbpos hC (hQat x hxmem)
    (hR_at x hxmem) (hA_at x hxmem)
  have hFy := enlargedF_eq_piece hbpos hC hQy
    (hR_at y hymem) (hA_at y hymem)
  have hFη := enlargedF_eq_piece hbpos hC (hQat eta hη)
    (hR_at eta hη) (hA_at eta hη)
  have hpiece : enlargedFPiece b z rCap aCap eta ≤
      max (enlargedFPiece b z rCap aCap x)
        (enlargedFPiece b z rCap aCap y) := by
    cases aCap with
    | true =>
        have hconv := enlargedFPiece_capped_convexOn b z rCap
        exact hconv.le_max_of_mem_Icc (Set.mem_univ x) (Set.mem_univ y) hη
    | false =>
        have hc := enlargedQ_lt_k_sq hb hz hxlo
        have hQxy : enlargedQ b z y ≤ enlargedQ b z x := by
          have hmul := mul_nonneg hbpos.le (sub_nonneg.mpr hxy)
          unfold enlargedQ
          nlinarith
        have hconv := enlargedFPiece_radical_convexOn hb hz hc rCap
        exact hconv.le_max_of_mem_Icc
          ⟨hQat x hxmem, le_rfl⟩ ⟨hQy, hQxy⟩ hη
  calc
    enlargedF b z eta = enlargedFPiece b z rCap aCap eta := hFη
    _ ≤ max (enlargedFPiece b z rCap aCap x)
        (enlargedFPiece b z rCap aCap y) := hpiece
    _ = max (enlargedF b z x) (enlargedF b z y) := by rw [hFx, hFy]


private theorem negative_of_two_kink_segments
    (f : ℝ → ℝ) (lo hi r c eta : ℝ)
    (hlo : lo ≤ eta) (hhi : eta ≤ hi)
    (hneg : ∀ x, (x = lo ∨ x = hi ∨ x = r ∨ x = c) →
      lo ≤ x → x ≤ hi → f x < 0)
    (hseg : ∀ x y, lo ≤ x → x ≤ y → y ≤ hi →
      (y ≤ r ∨ r ≤ x) → (y ≤ c ∨ c ≤ x) →
      ∀ t ∈ Icc x y, f t ≤ max (f x) (f y)) :
    f eta < 0 := by
  by_cases hr : eta ≤ r
  · by_cases hc : eta ≤ c
    · let y := min hi (min r c)
      have hηy : eta ≤ y := by dsimp [y]; exact le_min hhi (le_min hr hc)
      have hyhi : y ≤ hi := min_le_left _ _
      have hyr : y ≤ r := (min_le_right _ _).trans (min_le_left _ _)
      have hyc : y ≤ c := (min_le_right _ _).trans (min_le_right _ _)
      have hycandidate : y = lo ∨ y = hi ∨ y = r ∨ y = c := by
        dsimp [y]
        rcases le_total hi (min r c) with h | h
        · rw [min_eq_left h]; exact Or.inr (Or.inl rfl)
        · rw [min_eq_right h]
          rcases le_total r c with h' | h'
          · rw [min_eq_left h']; exact Or.inr (Or.inr (Or.inl rfl))
          · rw [min_eq_right h']; exact Or.inr (Or.inr (Or.inr rfl))
      have hle := hseg lo y le_rfl (hlo.trans hηy) hyhi
        (Or.inl hyr) (Or.inl hyc) eta ⟨hlo, hηy⟩
      exact lt_of_le_of_lt hle (max_lt (hneg lo (Or.inl rfl) le_rfl
        (hlo.trans hhi)) (hneg y hycandidate (hlo.trans hηy) hyhi))
    · let x := max lo c
      let y := min hi r
      have hcx : c ≤ x := le_max_right _ _
      have hxη : x ≤ eta := max_le hlo (le_of_not_ge hc)
      have hηy : eta ≤ y := le_min hhi hr
      have hyhi : y ≤ hi := min_le_left _ _
      have hyr : y ≤ r := min_le_right _ _
      have hxcandidate : x = lo ∨ x = hi ∨ x = r ∨ x = c := by
        dsimp [x]
        rcases le_total lo c with h | h
        · rw [max_eq_right h]; exact Or.inr (Or.inr (Or.inr rfl))
        · rw [max_eq_left h]; exact Or.inl rfl
      have hycandidate : y = lo ∨ y = hi ∨ y = r ∨ y = c := by
        dsimp [y]
        rcases le_total hi r with h | h
        · rw [min_eq_left h]; exact Or.inr (Or.inl rfl)
        · rw [min_eq_right h]; exact Or.inr (Or.inr (Or.inl rfl))
      have hle := hseg x y (le_max_left lo c) (hxη.trans hηy) hyhi
        (Or.inl hyr) (Or.inr hcx) eta ⟨hxη, hηy⟩
      exact lt_of_le_of_lt hle (max_lt (hneg x hxcandidate
        (le_max_left lo c) (hxη.trans hhi))
        (hneg y hycandidate (hlo.trans hηy) hyhi))
  · by_cases hc : eta ≤ c
    · let x := max lo r
      let y := min hi c
      have hrx : r ≤ x := le_max_right _ _
      have hxη : x ≤ eta := max_le hlo (le_of_not_ge hr)
      have hηy : eta ≤ y := le_min hhi hc
      have hyhi : y ≤ hi := min_le_left _ _
      have hyc : y ≤ c := min_le_right _ _
      have hxcandidate : x = lo ∨ x = hi ∨ x = r ∨ x = c := by
        dsimp [x]
        rcases le_total lo r with h | h
        · rw [max_eq_right h]; exact Or.inr (Or.inr (Or.inl rfl))
        · rw [max_eq_left h]; exact Or.inl rfl
      have hycandidate : y = lo ∨ y = hi ∨ y = r ∨ y = c := by
        dsimp [y]
        rcases le_total hi c with h | h
        · rw [min_eq_left h]; exact Or.inr (Or.inl rfl)
        · rw [min_eq_right h]; exact Or.inr (Or.inr (Or.inr rfl))
      have hle := hseg x y (le_max_left lo r) (hxη.trans hηy) hyhi
        (Or.inr hrx) (Or.inl hyc) eta ⟨hxη, hηy⟩
      exact lt_of_le_of_lt hle (max_lt (hneg x hxcandidate
        (le_max_left lo r) (hxη.trans hhi))
        (hneg y hycandidate (hlo.trans hηy) hyhi))
    · let x := max lo (max r c)
      have hrx : r ≤ x := (le_max_left _ _).trans (le_max_right _ _)
      have hcx : c ≤ x := (le_max_right _ _).trans (le_max_right _ _)
      have hxη : x ≤ eta := max_le hlo (max_le (le_of_not_ge hr) (le_of_not_ge hc))
      have hxcandidate : x = lo ∨ x = hi ∨ x = r ∨ x = c := by
        dsimp [x]
        rcases le_total lo (max r c) with h | h
        · rw [max_eq_right h]
          rcases le_total r c with h' | h'
          · rw [max_eq_right h']; exact Or.inr (Or.inr (Or.inr rfl))
          · rw [max_eq_left h']; exact Or.inr (Or.inr (Or.inl rfl))
        · rw [max_eq_left h]; exact Or.inl rfl
      have hle := hseg x hi (le_max_left lo (max r c)) (hxη.trans hhi) le_rfl
        (Or.inr hrx) (Or.inr hcx) eta ⟨hxη, hhi⟩
      exact lt_of_le_of_lt hle (max_lt (hneg x hxcandidate
        (le_max_left lo (max r c)) (hxη.trans hhi))
        (hneg hi (Or.inr (Or.inl rfl)) (hlo.trans hhi) le_rfl))

private theorem enlarged_sqrt_lt_k {b z eta : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (heta : 1547 / 4026 - b + (4 / 5 : ℝ) * z ≤ eta)
    (hq : 0 ≤ enlargedQ b z eta) :
    Real.sqrt (enlargedQ b z eta) < 1 / 3 - z := by
  have hlt := enlargedQ_lt_k_sq hb hz heta
  have hs := Real.sq_sqrt hq
  have hnonneg := Real.sqrt_nonneg (enlargedQ b z eta)
  have hk : 0 < 1 / 3 - z := by linarith [hz.2, hb.2]
  nlinarith

/-- The enlarged upper-E2 signed-price expression is strictly negative
throughout its actual scalar domain. -/
theorem enlargedF_neg {b z eta : ℝ}
    (hb : b ∈ Icc (77 / 1098 : ℝ) (1 / 4))
    (hz : z ∈ Icc (0 : ℝ) b)
    (hlo : 1547 / 4026 - b + (4 / 5 : ℝ) * z ≤ eta)
    (hhi : eta ≤ 2 / 3 - b - z)
    (hq : 0 ≤ enlargedQ b z eta) :
    enlargedF b z eta < 0 := by
  let lo : ℝ := 1547 / 4026 - b + (4 / 5 : ℝ) * z
  let hiU : ℝ := 2 / 3 - b - z
  let hiQ : ℝ := rH0 b z / (2 * b)
  let hi : ℝ := min hiU hiQ
  let r : ℝ := rEta b
  let c : ℝ := kinkEtaC b z
  have hbpos : 0 < b := by linarith [hb.1]
  have hQhiQ : enlargedQ b z hiQ = 0 := by
    dsimp [hiQ, rH0, enlargedQ]
    field_simp [hbpos.ne']
    ring
  have hQ_of_le : ∀ x : ℝ, x ≤ hiQ → 0 ≤ enlargedQ b z x := by
    intro x hx
    have hmul := mul_nonneg hbpos.le (sub_nonneg.mpr hx)
    unfold enlargedQ at hQhiQ ⊢
    nlinarith
  have hηhiQ : eta ≤ hiQ := by
    dsimp [hiQ, rH0]
    apply (le_div_iff₀ (by positivity : 0 < 2 * b)).mpr
    unfold enlargedQ at hq
    nlinarith
  have hηlo : lo ≤ eta := hlo
  have hηhi : eta ≤ hi := le_min hhi hηhiQ
  have hneg : ∀ x, (x = lo ∨ x = hi ∨ x = r ∨ x = c) →
      lo ≤ x → x ≤ hi → enlargedF b z x < 0 := by
    intro x hx hxlo hxhi
    rcases hx with h | h | h | h
    · subst x
      have hqlo : 0 ≤ enlargedQ b z lo :=
        hQ_of_le lo (hxhi.trans (min_le_right _ _))
      have hpole := enlarged_sqrt_lt_k hb hz (show lo ≤ lo from le_rfl) hqlo
      have hQeq : enlargedQ b z lo = loQ b z := by
        dsimp [lo, enlargedQ, loQ]
        ring
      rw [hQeq] at hqlo hpole
      exact enlargedF_etaLo_neg hb hz hqlo hpole
    · subst x
      rcases le_total hiU hiQ with hcut | hcut
      · have heq : hi = hiU := min_eq_left hcut
        have hqhi : 0 ≤ enlargedQ b z hiU := by
          rw [← heq]
          exact hQ_of_le hi (min_le_right _ _)
        rw [heq]
        exact enlargedF_etaHiU_neg hb hz hqhi
      · have heq : hi = hiQ := min_eq_right hcut
        rw [heq]
        exact enlargedF_Qzero_neg hb hz hQhiQ
    · subst x
      have hqr : 0 ≤ enlargedQ b z r :=
        hQ_of_le r (hxhi.trans (min_le_right _ _))
      have hpole := enlarged_sqrt_lt_k hb hz hxlo hqr
      have hQeq : enlargedQ b z r = rQ b z := by
        dsimp [r, rEta, rQ, rQfun, enlargedQ]
        ring
      rw [hQeq] at hqr hpole
      exact enlargedF_etaR_neg hb hz hqr hpole
    · subst x
      exact enlargedF_etaC_neg hb hz hxlo
  have hseg : ∀ x y, lo ≤ x → x ≤ y → y ≤ hi →
      (y ≤ r ∨ r ≤ x) → (y ≤ c ∨ c ≤ x) →
      ∀ t ∈ Icc x y,
        enlargedF b z t ≤ max (enlargedF b z x) (enlargedF b z y) := by
    intro x y hxlo hxy hyhi hr hc t ht
    have hQy : 0 ≤ enlargedQ b z y :=
      hQ_of_le y (hyhi.trans (min_le_right _ _))
    rcases hr with hr | hr <;> rcases hc with hc | hc
    · exact enlargedF_piece_le_max hb hz hxlo hxy ht hQy false true
        (by simpa [r] using hr) (by simpa [c] using hc)
    · exact enlargedF_piece_le_max hb hz hxlo hxy ht hQy false false
        (by simpa [r] using hr) (by simpa [c] using hc)
    · exact enlargedF_piece_le_max hb hz hxlo hxy ht hQy true true
        (by simpa [r] using hr) (by simpa [c] using hc)
    · exact enlargedF_piece_le_max hb hz hxlo hxy ht hQy true false
        (by simpa [r] using hr) (by simpa [c] using hc)
  exact negative_of_two_kink_segments (enlargedF b z) lo hi r c eta
    hηlo hηhi hneg hseg

end Erdos1017.UpperE2UniversalScalar
